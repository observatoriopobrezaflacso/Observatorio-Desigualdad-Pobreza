. *   inglab    -> !missing(ing_lab)      (variante con ingreso laboral observa
> do)
. *----------------------------------------------------------------------------
> --*
. 
. foreach pob in total ocupados inglab {
  2. 
.     if "`pob'" == "total"    local filtro ""
  3.     if "`pob'" == "ocupados" local filtro "& ocupado_ok == 1"
  4.     if "`pob'" == "inglab"   local filtro "& !missing(ing_lab)"
  5. 
.     foreach dim in nacional area sexo edad educ {
  6. 
.         if "`dim'" == "nacional" local byv ""
  7.         if "`dim'" == "area"     local byv "area"
  8.         if "`dim'" == "sexo"     local byv "sexo"
  9.         if "`dim'" == "edad"     local byv "age_cat"
 10.         if "`dim'" == "educ"     local byv "educsup_ok"
 11. 
.         local cond "pobreza < . & fexp < . `filtro'"
 12.         if "`byv'" != "" local cond "`cond' & `byv' < ."
 13. 
.         preserve
 14.         collapse (mean) tasa_pobreza = pobreza (rawsum) n_casos = fexp ///
>             [iw = fexp] if `cond', by(anio `byv')
 15. 
.         generate tasa_pobreza_pct = 100 * tasa_pobreza
 16.         label variable tasa_pobreza_pct "Pobreza (%)"
 17. 
.         export excel using "$outdir/pobreza_`pob'_`dim'.xlsx", ///
>             replace firstrow(var)
 18.         restore
 19.     }
 20. }
