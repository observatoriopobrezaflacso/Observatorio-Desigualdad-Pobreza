> ependen de esta."
 21.         continue, break
 22.     }
 23.     else {
 24.         display as result _n "OK  `scr'.do  (" %6.1f `seg' " segundos)"
 25.         local corridas "`corridas' `scr'"
 26.     }
 27. }


