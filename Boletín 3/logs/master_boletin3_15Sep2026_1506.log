.     gen diff    = informal21 - informal22

.     gen se_diff = sqrt(se_h^2 + se_m^2)

.     gen z       = diff / se_diff

.     gen p_value = 2 * normal(-abs(z))

.     gen diff_sig = p_value < 0.05

