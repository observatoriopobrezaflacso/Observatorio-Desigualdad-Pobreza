. *------------------------------------------------------------------------------*
. * 01_panel.do — Construye el panel armonizado 2001-2025 de pobreza laboral
. *------------------------------------------------------------------------------*
. * Guarda DOS juegos de insumos:
. *   (a) las versiones corregidas  (sufijo _ok)
. *   (b) las versiones tal como las produce el codigo original (sufijo _orig)
. * Esto permite cuantificar el efecto de cada error sin volver a leer las bases.
. *
. * Mapa real de la condicion de actividad en las bases (verificado):
. *   2001-2005  condact  (clasificacion ANTIGUA, 0/1-8; ocupado = 0..4)
. *   2007-2013  CONDACT + CONDACTN  (MAYUSCULAS)
. *   2014-2015  condact + condactn
. *   2016-2017  condactn  unicamente
. *   2018-2025  condact   unicamente, pero con la clasificacion NUEVA (0-9)
. * En la clasificacion NUEVA ocupado = 1..6 (no ocupado = 0,7,8,9).
. *------------------------------------------------------------------------------*
. 
. do "00_config.do"

. *------------------------------------------------------------------------------*
. * 00_config.do — Rutas y parametros comunes (Pobreza laboral, Boletin 3)
. *------------------------------------------------------------------------------*
. * Detecta la raiz de Google Drive segun el usuario de la maquina, en lugar de
. * fijar "/Users/vero/...". Si se agrega un colaborador, basta con anadir su caso.
. *------------------------------------------------------------------------------*
. 
. clear all

. set more off

. version 15.1

. set varabbrev off

. 
. local u = c(username)

. 
. if "`u'" == "vero" {
.     global user_root "/Users/vero/Library/CloudStorage/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"
.     global gh_root   "/Users/vero/Documents/Observatorio GH/Observatorio-Desigualdad-Pobreza"
. }

. else if "`u'" == "santiago" {
.     global user_root "/Users/santiago/Library/CloudStorage/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"
.     global gh_root   "/Users/santiago/Documents/GitHub/Observatorio-Desigualdad-Pobreza"
. }

. else {
.     display as error "Usuario `u' no configurado en 00_config.do. Defina user_root y gh_root."
.     error 198
. }

. 
. capture confirm file "$user_root/Bases/ENEMDU/Procesadas/ingresos_pc/Nacional/ing_perca_2001_nac_precios2000.dta"

. if _rc {
.     display as error "No se encuentra la carpeta de bases en: $user_root"
.     error 601
. }

. 
. global nacional    "$user_root/Bases/ENEMDU/Procesadas/ingresos_pc/Nacional"

. global lineas_xlsx "$user_root/Bases/lineas_pobreza/lineas_de_pobreza_historica.xlsx"

. 
. * Salidas en carpeta propia: NO se sobrescriben los resultados publicados.
. global outdir   "$user_root/Boletín 3/4. Resultados/pobreza laboral/corregido"

. global paneldir "$user_root/Bases/ENEMDU/Procesadas/ingresos_pc/pobreza"

. 
. capture mkdir "$user_root/Boletín 3/4. Resultados/pobreza laboral"

. capture mkdir "$outdir"

. capture mkdir "$paneldir"

. 
. * Anios procesados: rondas de diciembre disponibles a nivel nacional.
. global anios "2001(2)2007 2008(1)2025"

. 
. display as text "Configuracion lista para usuario `u'."
Configuracion lista para usuario santiago.

. 
end of do-file

. 
. *--- Lineas de pobreza anuales (diciembre, precios corrientes) ---*
. tempfile lineas

. import excel using "$lineas_xlsx", clear
(5 vars, 58 obs)

. rename A anio

. rename C linea_pobreza

. keep anio linea_pobreza

. foreach v in anio linea_pobreza {
  2.     capture confirm numeric variable `v'
  3.     if _rc destring `v', replace force
  4. }
anio: contains nonnumeric characters; replaced as int
(1 missing value generated)
linea_pobreza: contains nonnumeric characters; replaced as double
(1 missing value generated)

. drop if missing(anio) | missing(linea_pobreza)
(1 observation deleted)

. duplicates drop anio, force

Duplicates in terms of anio

(0 observations are duplicates)

. save `lineas', replace
(file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 not found)
file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 saved as .dta format

. 
. *--- Procesamiento anio por anio ---*
. local anios_all

. foreach y of numlist $anios {
  2.     local anios_all `anios_all' `y'
  3. }

. 
. * Las variables de diseno muestral cambian de tipo entre anios (plan_muestreo y
. * estrato son string en algunos, numericas en otros). Se guardan todas como
. * string para que el append nunca falle por conflicto de tipos.
. local svyvars ciudad zona sector plan_muestreo estrato upm

. 
. foreach y of local anios_all {
  2. 
.     local infile "$nacional/ing_perca_`y'_nac_precios2000.dta"
  3. 
.     capture confirm file "`infile'"
  4.     if _rc {
  5.         display as error "No existe el archivo: `infile'"
  6.         error 601
  7.     }
  8. 
.     * Linea de pobreza del anio
.     quietly use `lineas', clear
  9.     quietly keep if anio == `y'
 10.     if _N != 1 {
 11.         display as error "No hay linea de pobreza unica para `y'"
 12.         error 459
 13.     }
 14.     local lp = linea_pobreza[1]
 15. 
.     * Solo se cargan las variables que existen en ese anio
.     quietly describe using "`infile'", varlist
 16.     local vl `r(varlist)'
 17.     local loadv
 18.     foreach v in ingtot_per ing_lab fexp area sexo p02 edad p03 p24 hortrasa ///
>                  p25 p27 p28 nivinst nnivins p10a ///
>                  condact condactn CONDACT CONDACTN `svyvars' {
 19.         local h : list posof "`v'" in vl
 20.         if `h' local loadv `loadv' `v'
 21.     }
 22. 
.     quietly use `loadv' using "`infile'", clear
 23.     quietly generate int anio = `y'
 24. 
.     *--- Armonizacion de nombres ---*
.     capture confirm variable hortrasa
 25.     if !_rc rename hortrasa p24
 26. 
.     capture confirm variable p03
 27.     if !_rc rename p03 edad
 28. 
.     capture confirm variable sexo
 29.     if _rc {
 30.         capture confirm variable p02
 31.         if !_rc  generate byte sexo = p02
 32.         else     generate byte sexo = .
 33.     }
 34. 
.     foreach v in p24 edad p25 p27 p28 {
 35.         capture confirm variable `v'
 36.         if _rc quietly generate double `v' = .
 37.     }
 38. 
.     *--- Condicion de actividad: version CORREGIDA ---*
.     * cond_nueva = clasificacion nueva (0-9); cond_vieja = clasificacion antigua
.     quietly generate byte cond_nueva = .
 39.     quietly generate byte cond_vieja = .
 40. 
.     if inrange(`y', 2001, 2005) {
 41.         quietly replace cond_vieja = condact
 42.     }
 43.     else if inrange(`y', 2007, 2013) {
 44.         quietly replace cond_nueva = CONDACTN
 45.         quietly replace cond_vieja = CONDACT
 46.     }
 47.     else if inrange(`y', 2014, 2015) {
 48.         quietly replace cond_nueva = condactn
 49.         quietly replace cond_vieja = condact
 50.     }
 51.     else if inrange(`y', 2016, 2017) {
 52.         quietly replace cond_nueva = condactn
 53.     }
 54.     else if `y' >= 2018 {
 55.         quietly replace cond_nueva = condact
 56.     }
 57. 
.     * Ocupado corregido: nunca imputa 1 a los valores perdidos.
.     quietly generate byte ocupado_ok = .
 58.     quietly replace ocupado_ok = inrange(cond_nueva, 1, 6) if !missing(cond_nueva)
 59.     quietly replace ocupado_ok = inrange(cond_vieja, 0, 4) ///
>         if missing(cond_nueva) & !missing(cond_vieja)
 60. 
.     *--- Condicion de actividad: replica EXACTA del codigo original ---*
.     * El original hacia: cap confirm variable CONDACT / if !_rc rename CONDACTN*, lower
.     * y despues keep ... condact*  (patron sensible a mayusculas).
.     quietly generate byte condact_orig  = .
 61.     quietly generate byte condactn_orig = .
 62. 
.     capture confirm variable CONDACTN
 63.     if !_rc quietly replace condactn_orig = CONDACTN          // 2007-2013
 64.     capture confirm variable condactn
 65.     if !_rc quietly replace condactn_orig = condactn          // 2014-2017
 66.     capture confirm variable condact
 67.     if !_rc quietly replace condact_orig = condact            // 2001-2005, 2014-2015, 2018-2025
 68.     * CONDACT en mayusculas se perdia con "keep condact*": se replica ese descarte.
. 
.     *--- Educacion superior ---*
.     * Codigos verificados:
.     *   2001        nivinst: 6=superior, 7=postgrado
.     *   2003-2005   nivinst: 8=superior no univ., 9=superior univ., 10=postgrado
.     *   2007+       p10a   : 8=superior no univ., 9=superior univ., 10=postgrado
.     * _ok    = educacion superior en sentido amplio (incluye superior no universitaria),
.     *          comparable con el codigo 6 de 2001.
.     * _orig  = lo que hacia el codigo original (excluia superior no universitaria
.     *          desde 2003, pero la incluia en 2001).
.     quietly generate byte educsup_ok   = .
 69.     quietly generate byte educsup_orig = .
 70. 
.     if `y' == 2001 {
 71.         quietly replace educsup_ok   = inlist(nivinst, 6, 7) if !missing(nivinst)
 72.         quietly replace educsup_orig = inlist(nivinst, 6, 7) if !missing(nivinst)
 73.     }
 74.     else if inrange(`y', 2003, 2005) {
 75.         quietly replace educsup_ok   = inlist(nivinst, 8, 9, 10) if !missing(nivinst)
 76.         quietly replace educsup_orig = inlist(nivinst, 9, 10)    if !missing(nivinst)
 77.     }
 78.     else {
 79.         quietly replace educsup_ok   = inlist(p10a, 8, 9, 10) if !missing(p10a)
 80.         quietly replace educsup_orig = inlist(p10a, 9, 10)    if !missing(p10a)
 81.     }
 82. 
.     *--- Pobreza ---*
.     * ingtot_per esta en precios corrientes, igual que linea_pobreza_dic. Coherente.
.     quietly generate double linea_pobreza   = `lp'
 83.     quietly generate double ingreso_pobreza = ingtot_per
 84.     quietly generate byte   pobreza = (ingreso_pobreza < linea_pobreza) ///
>         if !missing(ingreso_pobreza)
 85. 
.     *--- Variables de diseno muestral presentes ese anio ---*
.     foreach v of local svyvars {
 86.         capture confirm variable `v'
 87.         if _rc {
 88.             quietly generate str1 `v' = ""
 89.         }
 90.         else {
 91.             capture confirm string variable `v'
 92.             if _rc quietly tostring `v', replace force
 93.         }
 94.     }
 95. 
.     quietly keep anio fexp sexo area edad p24 p25 p27 p28 ///
>                  ing_lab ingtot_per ingreso_pobreza linea_pobreza pobreza ///
>                  cond_nueva cond_vieja ocupado_ok condact_orig condactn_orig ///
>                  educsup_ok educsup_orig `svyvars'
 96. 
.     quietly compress
 97.     tempfile a`y'
 98.     quietly save `a`y''
 99. 
.     quietly count if pobreza == 1
100.     local np = r(N)
101.     quietly count if !missing(pobreza)
102.     local nv = r(N)
103.     display as text "`y': linea = " as result %7.2f `lp' ///
>         as text "  pobres/validos = " as result %9.0fc `np' as text " / " as result %9.0fc `nv'
104. }
