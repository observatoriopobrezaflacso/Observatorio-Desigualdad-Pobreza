. 
. * ----------------------------------------------------------------
. * ANIOS EXCLUIDOS DE TODA LA SERIE: 2001 y 2002
. *   2002: muestra muy reducida frente a los anios vecinos.
. *   2001: la pregunta de RUC (pe51) solo se le hace a patronos y a
. *         cuenta propia. Entre los asalariados tiene dato el 0.7%,
. *         frente a 88-90% desde 2003 (2002 llega al 100%). Con la
. *         armonizacion corregida esos casos quedan en missing, asi que
. *         el indicador de 2001 se calculaba sobre un tercio de los
. *         ocupados, casi todos independientes: no es comparable.
. *         La serie con el criterio de RUC arranca entonces en 2003.
. * ----------------------------------------------------------------
. 
. * ============================================================
. **# INFORMALIDAD 1
. * ============================================================
. gen informal1 =  affiliated    == 0 | ///
>                                  adec               == 0 | ///
>                                  no_remunerado      == 1 

. replace informal1 = . if inlist(., affiliated, adec, no_remunerado)                              
(586,570 real changes made, 586,570 to missing)

. 
. * ============================================================
. **# INFORMALIDAD 1 SIM
. * ============================================================
. gen informal1_sim = ///
>                                   affiliated    == 0 | ///
>                                   adec_sim           == 0 | ///
>                                   no_remunerado      == 1 

. replace informal1_sim = . if inlist(., affiliated, adec_sim, no_remunerado)                              
(586,570 real changes made, 586,570 to missing)

. 
. * ============================================================
. **#  INFORMALIDAD 2
. * ============================================================
. gen informal2 =  affiliated    == 0 | ///
>                                  adec               == 0 | ///
>                                  no_remunerado      == 1 | ///
>                                  (institucion_formal == 0) 

. replace informal2 = . if inlist(., affiliated, adec,  institucion_formal, no_remunerado)
(833,700 real changes made, 833,700 to missing)

. 
. 
. 
. * ============================================================
. **#  INFORMALIDAD 2 SIM
. * ============================================================
. gen informal2_sim =  ///
>                                  affiliated        == 0 | ///
>                                  adec_sim               == 0 | ///
>                                  no_remunerado          == 1 | ///
>                                  (institucion_formal == 0) 

. replace informal2_sim = . if inlist(., affiliated, adec_sim,  institucion_formal, no_remunerado)
(833,700 real changes made, 833,700 to missing)

. 
. * ===============================================================
. **# INFORMALIDAD CON Y SIN RUC 
. * ===============================================================
. 
. preserve

.     collapse (mean) informal1 informal2 if !inlist(anio, 2001, 2002) [iw = fexp], by(anio)

.         export excel using "$out_results/Tablas/informal_con_y_sin_ruc.xlsx", replace firstrow(var)
