. *============================================================================
> ==*
. * ARMONIZACIÓN: ESTABLECIMIENTO TIENE RUC (2001-2025)                        
> *
. * tiene_ruc = 1 si el establecimiento tiene RUC, 0 en otro caso              
>  *
. * "No sabe" se codifica como missing (.)                                     
>  *
. *============================================================================
> ==*
. 
. * Definición de rutas globales para facilitar la portabilidad del código
. global user_root "/Users/santiago/Library/CloudStorage/GoogleDrive-observator
> io.pobreza@flacso.edu.ec/Mi unidad/"

. global bases "$user_root/Bases"

. global raw "$bases/ENEMDU/Procesadas/Armonizacion/Variables base/Mensuales"

. global salarios "$bases/Salarios"

. global out "$bases/ENEMDU/Procesadas/analisis informalidad/Santiago"

. global gh "/Users/santiago/Documents/GH/Observatorio-Desigualdad-Pobreza/"

. global out_plot "$user_root/Boletín 3/2. Armonización de variables/Gráficos d
> e control"

. 
. global important_variable tiene_ruc

. 
. use "$raw/empleo1990.dta" in 1, clear 

. destring area, replace
area: all characters numeric; replaced as byte

. drop in 1
(1 observation deleted)

. 
. tempfile ruc_acumulado

. save `ruc_acumulado', replace
(dataset contains 0 observations)
(file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 not
    found)
file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 saved
    as .dta format

. 
. foreach y of numlist 2001(1)2025 {
  2. 
.     di "*****************   `y'   ************************"
  3. 
.     use "$raw/empleo`y'.dta", clear 
  4.     
.     rename *, lower
  5.     
.     * Inicializar variable armonizada de RUC
.     gen tiene_ruc = .
  6.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 1990-2000: NO DISPONIBLE
.     *------------------------------------------------------------------------
> --*
.     if (inrange(`y', 1990, 2000)) {
  7.         * No hay información de RUC en estos años
.         replace tiene_ruc = .
  8.     }
  9.     
.     *------------------------------------------------------------------------
> --*
.     * 2001: Variable pe51 (el establecimiento tiene ruc)
.     * 1 si / 2 no
.     *------------------------------------------------------------------------
> --*
.     if (`y' == 2001) {
 10.         capture confirm variable pe51
 11.         if !_rc {
 12.             *replace tiene_ruc = 1 if pe51 == 1  // Sí
.             *replace tiene_ruc = 0 if pe51 == 2  // No
.             *replace tiene_ruc = . if missing(pe51)
.                         gen no_tiene_ruc = (pe51 == 2) if inlist(pe51, 1, 2)
 13.                         replace no_tiene_ruc = . if inrange(condact, 5, 8)
>                       
 14.                         replace tiene_ruc = (no_tiene_ruc * - 1) + 1
 15.                         gen institucion_formal = cond(catetrab == 1, 1, ti
> ene_ruc)
 16.                         replace institucion_formal = 1 if pertrabn == 2
 17. 
.         }
 18.     }
 19.     
.     *------------------------------------------------------------------------
> --*
.     * 2002: Variable pe49 (el establecimiento donde trabaja tiene ruc)
.     * 1 si / 2 no / 9 no sabe
.     *------------------------------------------------------------------------
> --*
.     if (`y' == 2002) {
 20. 
.         capture confirm variable pe49
 21.         if !_rc {
 22.            * replace tiene_ruc = 1 if pe49 == 1  // Sí
.            * replace tiene_ruc = 0 if pe49 == 2  // No
.            * replace tiene_ruc = . if pe49 == 9  // No sabe → missing
.            * replace tiene_ruc = . if missing(pe49)
.                    
.                         gen no_tiene_ruc = (pe49 == 2) if inlist(pe49, 1, 2)
 23.                         replace no_tiene_ruc = . if inrange(condact, 5, 8)
>  | pe49 == 9          
 24.                         replace tiene_ruc = (no_tiene_ruc * - 1) + 1
 25.                         gen institucion_formal = cond(catetrab == 1, 1, ti
> ene_ruc)
 26.                         replace institucion_formal = 1 if pertrabn == 2
 27.                         
.         }
 28.     }
 29.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2003-2006: Variable pe49 (establecimiento tiene ruc)
.     * 1 si / 2 no / 3 no sabe
.     *------------------------------------------------------------------------
> --*
.     if (inrange(`y', 2003, 2006)) {
 30.                         
.         capture confirm variable pe49
 31.         if !_rc {
 32.                         
.             *replace tiene_ruc = 1 if pe49 == 1  // Sí
.             *replace tiene_ruc = 0 if pe49 == 2  // No
.             *replace tiene_ruc = . if pe49 == 3  // No sabe → missing
.             *replace tiene_ruc = . if missing(pe49)
.                         gen no_tiene_ruc = pe49 == 2
 33.                         replace no_tiene_ruc = . if inrange(condact, 5, 8)
>  | pe49 == 3 | missing(pe49)          
 34.                         replace tiene_ruc = (no_tiene_ruc * - 1) + 1
 35.                         gen institucion_formal = cond(catetrab == 1, 1, ti
> ene_ruc)
 36.                         replace institucion_formal = 1 if pertrabn == 2
 37.                         
.         }
 38.     }
 39.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2007-2025: Variable p49 (El establecimiento tiene RUC)
.     * 1 Si / 2 No / 3 No sabe
.     *------------------------------------------------------------------------
> --*
.     if (`y' >= 2007) {
 40.                 
.         capture confirm variable p49
 41.         if !_rc {
 42.             *replace tiene_ruc = 1 if p49 == 1  // Sí
.             *replace tiene_ruc = 0 if p49 == 2  // No
.             *replace tiene_ruc = . if p49 == 3  // No sabe → missing
.             *replace tiene_ruc = . if missing(p49)
.                         
.                         cap confirm variable condactn 
 43.                         if !_rc local condact_var condactn
 44.                         else    local condact_var condact
 45.                         
.                         gen no_tiene_ruc = p49 == 2 if p49 != 3 & !missing(p4
> 9) & empleo == 1
 46.                         replace tiene_ruc = (no_tiene_ruc * - 1) + 1
 47. 
.                         gen institucion_formal = cond(p47a == 2, 1, tiene_ruc
> ) ///
>                         if empleo == 1
 48.                         
.         }
 49.     }
 50.     
.     * Etiquetar variable RUC
.     label define lbl_ruc 0 "No tiene RUC" 1 "Tiene RUC", replace
 51.     label values tiene_ruc lbl_ruc
 52.     label variable tiene_ruc "Establecimiento tiene RUC (armonizado)"
 53.         
.          * Etiquetar variable institucion formal
.     label define lbl_if 0 "No Institucion Formal" 1 "Institucion Formal", rep
> lace
 54.     label values institucion_formal lbl_if
 55.     label variable institucion_formal "Trabaja en institucion formal"
 56. 
.     
.     * do "$gh/Generales/id_persona_loop.do"
.     
.     capture confirm variable area 
 57.     if  !_rc {
 58.         local area_var area
 59.         destring area, replace 
 60.     }
 61.     else local area_var 
 62.     
.     keep id_persona $important_variable anio `area_var' institucion_formal no
> _tiene_ruc fexp
 63.     
.     append using `ruc_acumulado'
 64.     
.     keep id_persona $important_variable anio `area_var' institucion_formal  n
> o_tiene_ruc fexp
 65.         
.     save `ruc_acumulado', replace
 66.     
.     di "*************** `y' *****************"
 67.     
.     count if id_persona == ""
 68.     local n = r(N)
 69.     
.     if (`n' != 0) asd
 70. 
. }
