. forval anio = 2013/2025 {
  2. 
.         di "********************************`anio' (nativo Rev. 4)***********
> *********************"
  3. 
.         capture confirm file "$bases/empleo`anio'.dta"
  4.         if _rc continue
  5.         use "$bases/empleo`anio'.dta", clear
  6. 
.         * Normaliza p40 a string de 4 digitos.
.         capture confirm variable p40
  7.         if !_rc {
  8.                 tostring p40, replace force
  9.                 replace p40 = strtrim(p40)
 10.                 replace p40 = substr("0000" + p40, -4, .) if p40 != "" & p
> 40 != "."
 11.         }
 12. 
.         * Asegura tipo numerico de rama1 con la misma etiqueta Rev. 4.
.         capture confirm variable rama1
 13.         if !_rc {
 14.                 capture confirm numeric variable rama1
 15.                 if _rc {
 16.                         destring rama1, replace force
 17.                 }
 18.                 label define rama_isic4 ///
