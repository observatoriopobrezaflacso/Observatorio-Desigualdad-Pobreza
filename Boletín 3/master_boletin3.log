>>> [armonizacion] armonizacion_pea.do   (21:49:47)
------------------------------------------------------------------------------

. * PEA armonizada        
. 
. * ======================================================================
. * 0. CONFIGURACIÓN INICIAL Y RUTAS
. * ======================================================================
. clear all

. set more off

. 
. * Raiz del Drive segun el usuario que corre el script: antes estaba fija en
. * la carpeta de vero, asi que el do-file no arrancaba en otras maquinas.
. if "`c(username)'" == "vero" global user_root "/Users/vero/Library/CloudStora
> ge/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. else                         global user_root "/Users/santiago/Library/CloudS
> torage/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. global bases "$user_root/Bases"

. global raw "$bases/ENEMDU/Procesadas/Armonizacion/Variables base/Mensuales"

. global out "$bases/ENEMDU/Procesadas/analisis informalidad/Santiago"

. global out_plot "$user_root/Boletín 3/2. Armonización de variables/Gráfico
> s de control"

. 
. 
. 
. * ======================================================================
. * 1. BUCLE DE PROCESAMIENTO CON TABLAS DE VALORES ABSOLUTOS
. * ======================================================================
. forvalues anio_loop = 1990/2025 {
  2.     
.     use "$raw/empleo`anio_loop'.dta", clear
  3.         
.     * --- A. PROCESAMIENTO SILENCIOSO ---
.     quietly {
  4.         capture rename p03 edad
  5.         drop if edad < 15
  6.         capture rename anio_encuesta anio
  7.         capture rename periodo anio
  8. 
.         * Condición de Actividad
.         capture confirm variable condactn
  9.         if _rc == 0 local v_cond "condactn"
 10.         else {
 11.             capture confirm variable condact
 12.             if _rc == 0 local v_cond "condact"
 13.             else local v_cond ""
 14.         }
 15. 
.         * Sectorización
.         local v_sect ""
 16.         foreach v in peamsiu SECEMP secemp {
 17.             capture confirm variable `v'
 18.             if _rc == 0 {
 19.                 local v_sect "`v'"
 20.                 continue, break
 21.             }
 22.         }
 23. 
.         * Creación de PEA
.         if "`v_cond'" != "" {
 24.             capture drop mi_pea
 25.             gen mi_pea = 0
 26.             if `anio_loop' <= 2013 replace mi_pea = 1 if inrange(`v_cond',
>  0, 6)
 27.             else               replace mi_pea = 1 if inrange(`v_cond', 1, 
> 8)
 28.             
.             label define lpea 1 "PEA" 0 "Inactivo", replace
 29.             label values mi_pea lpea
 30.         }
 31.         
.         gen sector_armonizado = .
 32.         if "`v_sect'" != "" replace sector_armonizado = `v_sect'
 33.     }
 34. 
.         
.     * Tabla 1: Cruce de Condición de Actividad vs Nuestra PEA
.     tab `v_cond' mi_pea [iw=fexp], missing
 35.     
.     * Tabla 2: Cruce de nuestra PEA con Sector
.     if "`v_sect'" != "" {
 36.         display "2. Distribución de la PEA por Sector (`v_sect'):"
 37.         tab mi_pea `v_sect' [iw=fexp], missing
 38.     }
 39.     else {
 40.         display "❌ No se detectó variable de sector en este año."
 41.     }
 42. 
.         
. 
.     * --- C. GUARDADO ---
.     quietly {
 43.         capture confirm variable id_persona
 44.         if _rc == 0 {
 45.                         
.                         cap confirm variable area
 46.                         if !_rc local area_var area
 47.                         else    local area_var 
 48.             keep id_persona anio mi_pea sector_armonizado fexp `area_var'
 49.                         tempfile clasif_`anio_loop'
 50.             save `clasif_`anio_loop'', replace
 51.             local guardado "SÍ"
 52.         }
 53.         else local guardado "NO"
 54.     }
 55.     
.     if "`guardado'" == "SÍ" display "✅ Base espejo guardada con éxito."
 56.     display ""
 57. }

