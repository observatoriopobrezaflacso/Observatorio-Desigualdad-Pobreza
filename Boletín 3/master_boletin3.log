. foreach y of numlist 2003(1)2025 {
  2. 
.     di "*****************   `y'   ************************"
  3. 
.     use "$raw/empleo`y'.dta", clear 
  4.     
.     rename *, lower
  5.     
.     * Inicializar variable armonizada de etnia
.     gen etnia_arm = .
  6.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 1990-2000: NO DISPONIBLE
.     *------------------------------------------------------------------------
> --*
.     if (inrange(`y', 1990, 2000)) {
  7.         * No hay información de etnia en estos años
.         replace etnia_arm = .
  8.     }
  9.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2001-2002: Variables pe13 (idioma) y pe14 (autoidentificación)
.     * pe14: 1 blanco / 2 negro / 3 indígena / 4 mestizo / 5 mulato / 6 otro
.     *------------------------------------------------------------------------
> --*
.     if (inrange(`y', 2001, 2002)) {
 10.         capture confirm variable pe14
 11.         if !_rc {
 12.             replace etnia_arm = 1 if pe14 == 3              // Indígena
 13.             replace etnia_arm = 2 if inlist(pe14, 2, 5)     // Negro/Mulat
> o
 14.             replace etnia_arm = 3 if inlist(pe14, 1, 4)     // Blanco/Mest
> izo
 15.             replace etnia_arm = 4 if pe14 == 6              // Otro
 16.             replace etnia_arm = . if missing(pe14)
 17.         }
 18.     }
 19.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2003: Variable pe13 (autoidentificación directa)
.     * pe13: 1 indígena / 2 blanco / 3 mestizo / 4 negro / 5 mulato / 6 otro
.     *------------------------------------------------------------------------
> --*
.     if (`y' == 2003) {
 20.         capture confirm variable pe13
 21.         if !_rc {
 22.             replace etnia_arm = 1 if pe13 == 1              // Indígena
 23.             replace etnia_arm = 2 if inlist(pe13, 4, 5)     // Negro/Mulat
> o
 24.             replace etnia_arm = 3 if inlist(pe13, 2, 3)     // Blanco/Mest
> izo
 25.             replace etnia_arm = 4 if pe13 == 6              // Otro
 26.             replace etnia_arm = . if missing(pe13)
 27.         }
 28.     }
 29.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2004-2006: Variable pe13 (autoidentificación directa)
.     * pe13: 1 indígena / 2 blanco / 3 mestizo / 4 negro / 5 mulato / 6 otro
.     *------------------------------------------------------------------------
> --*
.     if (inrange(`y', 2004, 2006)) {
 30.         capture confirm variable pe13
 31.         if !_rc {
 32.             replace etnia_arm = 1 if pe13 == 1              // Indígena
 33.             replace etnia_arm = 2 if inlist(pe13, 4, 5)     // Negro/Mulat
> o
 34.             replace etnia_arm = 3 if inlist(pe13, 2, 3)     // Blanco/Mest
> izo
 35.             replace etnia_arm = 4 if pe13 == 6              // Otro
 36.             replace etnia_arm = . if missing(pe13)
 37.         }
 38.     }
 39.     
.     *------------------------------------------------------------------------
> --*
.     * PERÍODO 2007-2024: Variable p15 (autoidentificación ampliada)
.     * p15: 1 Indígena / 2 Afroecuatoriano / 3 Negro / 4 Mulato / 
.     *      5 Montubio / 6 Mestizo / 7 Blanco / 8 Otro
.     *------------------------------------------------------------------------
> --*
.     if (`y' >= 2007) {
 40.         capture confirm variable p15
 41.         if !_rc {
 42.             replace etnia_arm = 1 if p15 == 1                    // Indíge
> na
 43.             replace etnia_arm = 2 if inlist(p15, 2, 3, 4)        // Afroec
> uatoriano/Negro/Mulato
 44.             replace etnia_arm = 3 if inlist(p15, 6, 7)           // Mestiz
> o/Blanco
 45.             replace etnia_arm = 4 if inlist(p15, 5, 8)           // Montub
> io/Otro
 46.             replace etnia_arm = . if missing(p15)
 47.         }
 48.     }
 49.     
.     * Etiquetar variable armonizada
.     label define lbl_etnia 1 "Indígena" 2 "Negro/Afro" 3 "Blanco/Mestizo" 4 "
> Otro", replace
 50.     label values etnia_arm lbl_etnia
 51.     label variable etnia_arm "Etnia (armonizado)"
 52.     
.     * do "$gh/Generales/id_persona_loop.do"
.     
.     capture confirm variable area 
 53.     if  !_rc {
 54.         local area_var area
 55.         destring area, replace 
 56.     }
 57.     else local area_var 
 58.     
.     keep id_persona $important_variable anio `area_var'
 59.     
.     append using `etnia_acumulado'
 60.     
.     keep id_persona $important_variable anio `area_var'
 61.         
.     save `etnia_acumulado', replace
 62.     
.     di "*************** `y' *****************"
 63.     
.     count if id_persona == ""
 64.     local n = r(N)
 65.     
.     if (`n' != 0) asd
 66. 
. }
