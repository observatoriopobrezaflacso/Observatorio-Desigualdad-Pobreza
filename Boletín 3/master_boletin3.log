. foreach y of numlist 1991(1)2025 {
  2. 
.     di "*****************   `y'   ************************"
  3. 
.     quietly {
  4. 
.         scalar edadmin = 15
  5. 
.         use "$raw/empleo`y'.dta", clear
  6. 
.         * Trae salario_min_sim del año correspondiente
.         merge m:m anio using `deflactor', keep(3) nogen
  7. 
.         cap gen t = 1
  8.         cap rename t t_a
  9. 
.         if inrange(`y', 1990, 2006) {
 10.             rename edad     edad
 11.             rename trabajo  p20
 12.             rename actayuda p21
 13.             rename aunotra  p22
 14.             rename hortrasa p24
 15.             rename ratmeh   p25
 16.             rename bustrama p32
 17.             rename motnobus p34
 18.             rename deseatra p35
 19.             rename hortrahp p51a
 20.             rename hortrahs p51b
 21.             rename hortraho p51c
 22.             if `y' >= 2001 rename hormas p27
 23.         }
 24. 
.         * Hasta 2000 no hay sí/no de "desea más horas": se infiere de tener
.         * motivo anotado. 1991-1992: ratmeh1, sin los códigos 7-8 (personales
> ,
.         * enfermedad), que desde 1993 van a p25 == 2. 1993-2000: hormas. En
.         * 1992 hormas es el sí/no, no el motivo, y no sirve para inferir.
.         if inrange(`y', 1990, 2000) {
 25.             cap drop p27
 26.             cap gen p27 = 2 if p20 == 1 | p22 == 1
 27.             if `y' <= 1992 replace p27 = 1 if inlist(ratmeh1, 3, 4, 5, 6, 
> 9)
 28.             else           replace p27 = 1 if hormas != .
 29.         }
 30. 
.         
.         *--------- PET ---------*
.         cap confirm variable petn
 31.         if !_rc drop petn
 32.         gen petn = .
 33.         replace petn = 0 if edad <  edadmin
 34.         replace petn = 1 if edad >= edadmin
 35.         label variable petn "Población en Edad de Trabajar"
 36. 
.         *--------- PEA ---------*
.         cap confirm variable pean
 37.         if !_rc drop pean
 38.         gen pean = .
 39.         replace pean = 0 if petn == 1
 40.         replace pean = 1 if petn == 1 & p20 == 1
 41. 
.         if anio >= 2007 {
 42.             replace pean = 1 if petn == 1 & p20 == 2 & p21 <= 11
 43.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 1
 44.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 2 & p32 <= 10
 45.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 2 & p32 == 11 & p34 <= 7 & p35 == 1
 46.         }
 47.         else if inrange(anio, 2001, 2006) {
 48.             replace pean = 1 if petn == 1 & p20 == 2 & p21 <= 10
 49.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 11 & p22 == 
> 1
 50.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 11 & p22 == 
> 2 & p32 == 1
 51.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 11 & p22 == 
> 2 & p32 == 2 & p34 <= 7 & p34 != 4 & p35 == 1
 52.         }
 53.         else {
 54.             replace pean = 1 if petn == 1 & p20 == 2 & p21 <= 11
 55.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 1
 56.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 2 & p32 == 1
 57.             * Desempleo oculto: ocasionales, esperas y desalentados dentro
>  de la
.             * PEA; fuera los que no pueden participar (sin tiempo, familia,
.             * enfermedad, edad). El bloque de desaliento de motnobus son los
.             * códigos 5-8 hasta 1998 y los 1-4 desde 1999: la lista se reorde
> na
.             * y las etiquetas del .dta de 1999-2000 se quedaron con el orden
.             * viejo. El orden real se verifica con condact (5/6 = desocupados
> ) y
.             * con el universo al que se preguntó deseatra, que es ese bloque.
.             * inrange() ya excluye el missing, que con ">=" entraría a la PEA
> .
.             if `y' <= 1998 local desalent "inrange(p34, 5, 8)"
 58.             else           local desalent "inrange(p34, 1, 4)"
 59.             replace pean = 1 if petn == 1 & p20 == 2 & p21 == 12 & p22 == 
> 2 & ///
>                                 p32 == 2 & `desalent' & p35 == 1
 60.         }
 61.         label variable pean "Población Económicamente Activa"
 62. 
.         *--------- EMPLEO ---------*
.         cap confirm variable empleo
 63.         if !_rc drop empleo
 64.                 
.         gen empleo = .
 65.         replace empleo = 0 if pean == 1
 66.         replace empleo = 1 if pean == 1 & p20 == 1
 67. 
.         if inrange(anio, 2001, 2006) {
 68.             replace empleo = 1 if pean == 1 & p20 == 2 & p21 <= 10
 69.             replace empleo = 1 if pean == 1 & p20 == 2 & p21 == 11 & p22 =
> = 1
 70.         }
 71.         else {
 72.             replace empleo = 1 if pean == 1 & p20 == 2 & p21 <= 11
 73.             replace empleo = 1 if pean == 1 & p20 == 2 & p21 == 12 & p22 =
> = 1
 74.         }
 75.         label variable empleo "Población con Empleo"
 76. 
.         *--------- 1. INGRESO LABORAL ---------*
.         * En doble precisión: en float, el redondeo del umbral simulado (que 
> en
.         * los 90s es un número grande, en sucres) desplaza el corte para quie
> n
.         * gana justo el umbral.
.         gen double ila = ingrl
 77. 
.         * Códigos de no respuesta / valor atípico, año por año. Cada lista
.         * reproduce exactamente la rama de ese año en
.         *   "Boletín 1/Procesamiento/Codigos/Ingresos/ingresos_anios_all_fn.d
> o",
.         * tomando sólo los componentes que entran en el ingreso LABORAL: los
.         * códigos de rentas, remesas y bono no se aplican aquí. No hay una li
> sta
.         * transversal: el juego de códigos cambia con el cuestionario.
.         *
.         *   1991       ingpat
.         *   1992-1999  ingpat ingasg ingepv ingdom
.         *   2000       ingpat retpat ingasa ingasa1 ingasa2 ingsec
.         *   2001-2009  recode ingrl (-1 = .) (999999 = .)
.         *   2006       pe61 pe62b pe63 pe64 pe65b pe66 pe67b
.         *   2010-2025  p63 p64b p65 p66 p67 p68b p69 p70b, y recode ingrl 999
> 999
.         *
.         * 2002 y 2004 no tienen rama propia en ese script; se les aplica la d
> e
.         * los años vecinos (2001/2003/2005), que es idéntica entre sí.
.         *
.         * Sustituye a los topes nominales fijos "ila >= 900000" (90s) y
.         * "ila >= 90000" (2000+). En sucres un tope fijo no es neutro: el SBU
>  de
.         * diciembre pasa de 94.333 (1991) a 596.667 (1999), así que 900.000 c
> ae
.         * de 9,5 a 1,5 veces el umbral y llegaba a anular al 47 % de los
.         * ocupados en 1999. Como los no clasificables cuentan como no adecuad
> os,
.         * eso hundía artificialmente la serie de los 90s.
.         *
.         * Se decide con el local `y' y no con la variable anio: en un comando
>  if
.         * Stata evalúa sólo la primera observación.
.         local invalidos ""
 78.         if `y' == 1991                  local invalidos "9999998"
 79.         if inrange(`y', 1992, 1999)     local invalidos "9999998 9999999 9
> 9999999"
 80.         if `y' == 2000                  local invalidos "-1 9999 10000 999
> 99 999999 9999999 39999999 89999999 99999999"
 81.         if inrange(`y', 2001, 2005)     local invalidos "-1 999999"
 82.         if `y' == 2006                  local invalidos "-1 999 9999 22150
>  99999 999999"
 83.         if inrange(`y', 2007, 2009)     local invalidos "-1 999999"
 84.         if `y' >= 2010                  local invalidos "-1 999999"
 85. 
.         foreach c of local invalidos {
 86.             replace ila = . if ila == `c'
 87.         }
 88. 
.         gen ineg = .
 89.         replace ineg = 1 if ingrl == -1
 90. 
.         * UMBRAL DE INGRESO BASADO EN SBU 2025 DEFLACTADO
.         gen w_sim = .
 91.         replace w_sim = 0 if empleo == 1 & ila <  salario_min_sim
 92.         replace w_sim = 1 if empleo == 1 & ila >= salario_min_sim & ila !=
>  .
 93.         replace w_sim = . if ila == .
 94.         label variable w_sim "Umbral de ingreso laboral (SBU 2025 deflacta
> do)"
 95.         label define w_lbl 0 "menor" 1 "mayor", replace
 96.         label values w_sim w_lbl
 97. 
.         *--------- 2. TIEMPO DE TRABAJO ---------*
.         * 999 = no responde también en p24 (hortrasa), no sólo en p51a-p51c.
.         * Hay que limpiarlo ANTES de volcarlo en horas: si no, esas personas
.         * quedan con 999 horas y por tanto con t = 1 (jornada completa).
.         replace p24 = . if p24 == 999
 98. 
.         gen horas = .
 99.         replace horas = 0 if empleo == 1
100.         replace horas = p24 if pean == 1 & p20 == 1
101.         if inrange(anio, 2001, 2006) replace horas = p24 if pean == 1 & p2
> 0 == 2 & p21 <= 10
102.         else                         replace horas = p24 if pean == 1 & p2
> 0 == 2 & p21 <= 11
103. 
.         replace p51a = . if p51a == 999
104.         replace p51b = . if p51b == 999
105.         replace p51c = . if p51c == 999
106. 
.         egen hh = rowtotal(p51a p51b p51c), missing
107.         replace hh = . if hh < 0
108. 
.         if inrange(anio, 2001, 2006) {
109.             replace horas = hh if pean == 1 & p20 == 2 & p21 == 11 & p22 =
> = 1
110.         }
111.         else {
112.             replace horas = hh if pean == 1 & p20 == 2 & p21 == 12 & p22 =
> = 1
113.         }
114. 
.         * Quien trabajó pero no declaró p24 se queda sin horas y por tanto co
> n
.         * t = . , o sea fuera del empleo adecuado aunque cumpla el ingreso. S
> i
.         * declaró las horas que trabaja habitualmente (p51a-p51c), se usan es
> as.
.         * Es el criterio de la clasificación oficial: sin este respaldo la se
> rie
.         * pierde 35 personas en 2007 que el INEC sí cuenta como adecuadas.
.         replace horas = hh if empleo == 1 & horas >= . & hh < .
115.         label variable horas "Horas de trabajo semanal"
116. 
.         capture drop t
117.         gen t = .
118.         replace t = 0 if empleo == 1 & horas <  40
119.         replace t = 1 if empleo == 1 & horas >= 40 & horas != .
120.         replace t = 0 if empleo == 1 & horas <  30 & edad >= 12 & edad <= 
> 17
121.         replace t = 1 if empleo == 1 & horas >= 30 & edad >= 12 & edad <= 
> 17
122.         label variable t "Umbral de horas trabajadas"
123. 
.         *--------- 3. DESEO Y DISPONIBILIDAD ---------*
.         gen d_d = .
124.         replace d_d = 0 if empleo == 1
125. 
.         if anio >= 2007 {
126.             replace d_d = 0 if empleo == 1 & (p25 == 9 | p27 == 4)
127.             replace d_d = 1 if empleo == 1 & p27 <= 3 & p28 == 1
128.         }
129.         else if inrange(anio, 2001, 2006) {
130.             replace d_d = 0 if empleo == 1 & p27 == 2
131.             replace d_d = 1 if empleo == 1 & p27 == 1
132.         }
133.         else if inrange(anio, 1993, 2000) {
134.             replace d_d = 0 if empleo == 1 & (p25 == 3 | p27 == 2)
135.             replace d_d = 1 if empleo == 1 & p27 == 1
136.         }
137.         else {
138.             replace d_d = 0 if empleo == 1 & (p25 == 2 | p27 == 2)
139.             replace d_d = 1 if empleo == 1 & p27 == 1
140.         }
141.         label variable d_d "Deseo y disponibilidad de trabajar horas adici
> onales"
142.         label define d_d_lbl 0 "No desea" 1 "Si desea y está disponible", 
> replace
143.         label values d_d d_d_lbl
144. 
.         *--------- EMPLEO ADECUADO OFICIAL (umbral SBU vigente) ---------*
.         * salario_min viene del deflactor (histórico SBU armado en sección 1b
> ).
.         gen w_off = .
145.         replace w_off = 0 if empleo == 1 & ila <  salario_min
146.         replace w_off = 1 if empleo == 1 & ila >= salario_min & ila != .
147.         replace w_off = . if ila == .
148.                 
.                 cap confirm variable adec
149.                 if !_rc drop adec
150. 
.         gen adec = .
151.         replace adec = 0 if pean == 1 & edad >= edadmin
152.         replace adec = 1 if pean == 1 & edad >= edadmin & empleo == 1 & w_
> off == 1 & t == 1
153.         replace adec = 1 if pean == 1 & edad >= edadmin & empleo == 1 & w_
> off == 1 & t == 0 & d_d == 0
154.         label variable adec "Empleo adecuado (umbral SBU vigente)"
155. 
.         *--------- EMPLEO ADECUADO SIMULADO ---------*
.         gen adec_sim = .
156.         replace adec_sim = 0 if pean == 1 & edad >= edadmin
157.         replace adec_sim = 1 if pean == 1 & edad >= edadmin & empleo == 1 
> & w_sim == 1 & t == 1
158.         replace adec_sim = 1 if pean == 1 & edad >= edadmin & empleo == 1 
> & w_sim == 1 & t == 0 & d_d == 0
159.         label variable adec_sim "Empleo adecuado simulado (umbral = SBU 20
> 25 deflactado)"
160. 
.     }
161. 
.         cap confirm variable condactn 
162.         if   !_rc local condact_var condactn
163.         else      local condact_var condact
164.         decode `condact_var', gen(condact_str)
165. 
.         replace adec = 0 if condact_str == "Otro empleo no pleno"
166. 
.         
.     capture confirm variable area
167.     if !_rc {
168.         local area_var area
169.         destring area, replace
170.     }
171.     else local area_var
172. 
.     * Conservamos ambas series (oficial y simulada) y ambos umbrales salarial
> es
.     keep id_persona anio `area_var' d_d t w_off ila  pean salario_min salario
> _min_sim adec adec_sim fexp
173. 
.     append using `adec_acumulado'
174.     save `adec_acumulado', replace
175. 
.     sum adec adec_sim
176. }
