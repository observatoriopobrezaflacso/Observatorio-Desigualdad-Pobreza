. 
. di as text "================ STEP 3: Rev 3.1 -> Rev 4 (1991-2025) ===========
> ====="
================ STEP 3: Rev 3.1 -> Rev 4 (1991-2025) ================

. do "$rama/ISIC3_1_to_ISIC4.do"

. clear

. 
. * Definicion de rutas globales para facilitar la portabilidad del codigo
. 
. if "`c(username)'" == "vero" global user_root "/Users/vero/Library/CloudStora
> ge/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. else                         global user_root "/Users/santiago/Library/CloudS
> torage/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. global bases "$user_root/Bases/ENEMDU/Procesadas/Armonizacion/Variables base/
> Mensuales"

. 
. 
. global isic "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. global out "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. 
. *----------------------------------------------------------------------------
> -
. * STEP 1: Preparar correspondencia CIIU Rev. 3.1 -> CIIU Rev. 4
. *----------------------------------------------------------------------------
> --
. 
. import delimited using "$isic/ISIC31_ISIC4.txt", clear
(5 vars, 737 obs)

. 
. tostring isic31code, replace
isic31code was int now str4

. tostring isic4code,  replace
isic4code was int now str4

. replace isic31code = strtrim(isic31code)
(0 real changes made)

. replace isic4code  = strtrim(isic4code)
(0 real changes made)

. drop if missing(isic31code) | missing(isic4code)
(0 observations deleted)

. 
. replace isic31code = substr("0000" + isic31code, -4, .)
(55 real changes made)

. replace isic4code  = substr("0000" + isic4code,  -4, .)
(81 real changes made)

. 
. * En codigos con multiples correspondencias se prioriza:
. * 1) correspondencia no parcial, 2) destino no parcial, 3) mismo codigo.
. gen byte exact_match = isic31code == isic4code

. gsort isic31code partialisic31 partialisic4 -exact_match isic4code

. duplicates drop isic31code, force

Duplicates in terms of isic31code

(439 observations deleted)

. 
. rename isic31code p40

. rename isic4code  p40_rev4_new

. 
. keep p40 p40_rev4_new

. tempfile crosswalk_clean

. save `crosswalk_clean'
file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 saved
    as .dta format

. 
. *----------------------------------------------------------------------------
> -
. * STEP 2: Actualizar bases 1991-2012 de CIIU Rev. 3.1 a Rev. 4
. *
. * Fuentes de entrada:
. *   - 1991-1999: $out/empleo`anio'_isic31.dta (salida de isic2_31.do)
. *   - 2000-2006: $out/empleo`anio'_isic31.dta (salida de isic3_31.do)
. *   - 2007-2012: empleo`anio'.dta original (ya estan en Rev. 3.1)
. *----------------------------------------------------------------------------
> --
. 
. forval anio = 1991/2012 {
  2. 
.         di "********************************`anio'***************************
> *****"
  3. 
.         if (inrange(`anio', 1991, 2006)) {
  4.                 capture noisily use "$out/empleo`anio'_isic31.dta", clear
  5.                 if _rc {
  6.                         di as error "  AVISO: falta empleo`anio'_isic31.dt
> a. Ejecute isic2_31.do / isic3_31.do primero."
  7.                         continue
  8.                 }
  9.         }
 10.         else {
 11.                 use "$bases/empleo`anio'.dta", clear
 12.         }
 13. 
.         * Asegura que p40 sea string de 4 digitos (ej. "0111").
.         tostring p40, replace force
 14.         replace p40 = strtrim(p40)
 15.         replace p40 = substr("0000" + p40, -4, .) if p40 != "" & p40 != ".
> "
 16. 
.         * Fusiona con el crosswalk Rev. 3.1 -> Rev. 4.
.         merge m:1 p40 using `crosswalk_clean', keep(master match)
 17. 
.         * Lista codigos no mapeados para revision manual.
.         tab p40 if missing(p40_rev4_new) & p40 != ""
 18.         drop _merge
 19. 
.         rename p40           p40_old_isic31
 20.         rename p40_rev4_new  p40
 21. 
.         *--------------------------------------------------------------------
> ------
.         * STEP 3: Generar la nueva 'rama1' (Secciones A-U) bajo CIIU Rev. 4
.         *--------------------------------------------------------------------
> ------
. 
.         gen rama_new = ""
 22.         gen isic2 = substr(p40, 1, 2)
 23. 
.         replace rama_new = "A" if isic2 >= "01" & isic2 <= "03"
 24.         replace rama_new = "B" if isic2 >= "05" & isic2 <= "09"
 25.         replace rama_new = "C" if isic2 >= "10" & isic2 <= "33"
 26.         replace rama_new = "D" if isic2 == "35"
 27.         replace rama_new = "E" if isic2 >= "36" & isic2 <= "39"
 28.         replace rama_new = "F" if isic2 >= "41" & isic2 <= "43"
 29.         replace rama_new = "G" if isic2 >= "45" & isic2 <= "47"
 30.         replace rama_new = "H" if isic2 >= "49" & isic2 <= "53"
 31.         replace rama_new = "I" if isic2 >= "55" & isic2 <= "56"
 32.         replace rama_new = "J" if isic2 >= "58" & isic2 <= "63"
 33.         replace rama_new = "K" if isic2 >= "64" & isic2 <= "66"
 34.         replace rama_new = "L" if isic2 == "68"
 35.         replace rama_new = "M" if isic2 >= "69" & isic2 <= "75"
 36.         replace rama_new = "N" if isic2 >= "77" & isic2 <= "82"
 37.         replace rama_new = "O" if isic2 == "84"
 38.         replace rama_new = "P" if isic2 == "85"
 39.         replace rama_new = "Q" if isic2 >= "86" & isic2 <= "88"
 40.         replace rama_new = "R" if isic2 >= "90" & isic2 <= "93"
 41.         replace rama_new = "S" if isic2 >= "94" & isic2 <= "96"
 42.         replace rama_new = "T" if isic2 >= "97" & isic2 <= "98"
 43.         replace rama_new = "U" if isic2 == "99"
 44. 
.         * Conserva la seccion anterior (Rev. 3.1) como respaldo si existia.
.         capture confirm variable rama1
 45.         if !_rc rename rama1 rama_old_isic31
 46. 
.         * Codificacion deterministica: la letra define directamente el numero
.         * (A=1, B=2, ..., U=21) independiente de las secciones presentes.
.         * strpos retorna 1 cuando la aguja es vacia, asi que se filtra explic
> ito.
.         gen byte rama1 = strpos("ABCDEFGHIJKLMNOPQRSTU", rama_new) if rama_ne
> w != ""
 47.         replace rama1 = . if rama1 == 0
 48.         drop isic2 rama_new
 49. 
.         label define rama_isic4 ///
>                 1  "A. Agricultura, ganaderia, silvicultura y pesca" ///
>                 2  "B. Explotacion de minas y canteras" ///
>                 3  "C. Industrias manufactureras" ///
>                 4  "D. Suministros de electricidad, gas, vapor y aire acondic
> ionado" ///
>                 5  "E. Distribucion de agua; alcantarillado, gestion de desec
> hos y saneamiento" ///
>                 6  "F. Construccion" ///
>                 7  "G. Comercio al por mayor y al por menor; reparacion de ve
> hiculos automotores y motocicletas" ///
>                 8  "H. Transporte y almacenamiento" ///
>                 9  "I. Actividades de alojamiento y de servicio de comidas" /
> //
>                 10 "J. Informacion y comunicaciones" ///
>                 11 "K. Actividades financieras y de seguros" ///
>                 12 "L. Actividades inmobiliarias" ///
>                 13 "M. Actividades profesionales, cientificas y tecnicas" ///
>                 14 "N. Actividades de servicios administrativos y de apoyo" /
> //
>                 15 "O. Administracion publica y defensa; seguridad social de 
> afiliacion obligatoria" ///
>                 16 "P. Ensenanza" ///
>                 17 "Q. Actividades de atencion de la salud humana y de asiste
> ncia social" ///
>                 18 "R. Actividades artisticas, de entretenimiento y recreativ
> as" ///
>                 19 "S. Otras actividades de servicios" ///
>                 20 "T. Actividades de los hogares como empleadores" ///
>                 21 "U. Actividades de organizaciones y organos extraterritori
> ales", replace
 50. 
.         label values rama1 rama_isic4
 51. 
.         save "$out/empleo`anio'_isic4.dta", replace
 52. }
