------------------------------------------------------------------------------
>>> [armonizacion] diseno_muestral.do   (21:49:04)
------------------------------------------------------------------------------

. *------------------------------------------------------------------*
. * DISEÑO MUESTRAL ENEMDU 1991-2025
. * Construye estrato y UPM (unidad primaria de muestreo) armonizados
. * para poder estimar errores estándar e intervalos de confianza.
. *------------------------------------------------------------------*
. * Resultado: $bases_armonizadas/historico_diseno_muestral.dta
. *   id_persona anio
. *   estrato_svy  (numérico, único por año)   <- strata() de svyset
. *   upm_svy      (numérico, único por año)   <- psu de svyset
. *   estrato_str upm_str                      <- códigos originales
. *   diseno_fuente                            <- de dónde sale cada uno
. *
. * Fuentes por período (verificado sobre los archivos empleo`y'.dta):
. *   UPM:
. *     1991-2017  ciudad + zona + sector  (sector censal = UPM)
. *     2018-2025  upm                     (identificador INEC)
. *   Estrato:
. *     1991-2014  provincia x area        (no hay variable de estrato;
. *                                         0-1 estratos con una sola UPM)
. *     2015-2017  plan_muestreo           (140-142 estratos INEC)
. *     2018-2025  estrato                 (150-160 estratos INEC)
. *
. * Nota: 1991-1992 traen una variable 'estrato' (0-3) que NO es el
. *       estrato de muestreo (son 4 categorías para todo el país), por
. *       eso no se usa.
. * Nota: 'conglomerado' (2017+) tiene solo 31 valores distintos, no es
. *       identificador de UPM.
. *------------------------------------------------------------------*
. 
. clear all

. set more off

. 
. global user_root "/Users/santiago/Library/CloudStorage/GoogleDrive-observator
> io.pobreza@flacso.edu.ec/Mi unidad"

. global raw "$user_root/Bases/ENEMDU/Procesadas/Armonizacion/Variables base/Me
> nsuales"

. global bases_armonizadas "$user_root/Bases/ENEMDU/Procesadas/analisis informa
> lidad/Santiago"

. 
. * Rango de años (se puede reducir para pruebas)
. global d_anio_ini 1991

. global d_anio_fin 2025

. 
. tempfile acumulado

. qui save `acumulado', emptyok replace

. 
. forval y = $d_anio_ini/$d_anio_fin {
  2. 
.     di as txt "************** `y' ********************"
  3. 
.     * --- qué variables de diseño existen en este año ---
.     qui describe using "$raw/empleo`y'.dta", varlist
  4.     local vlist `r(varlist)'
  5.     local hay_area : list posof "area" in vlist
  6. 
.     local dv
  7.     if `y' <= 2017              local dv ciudad zona sector
  8.     if inrange(`y', 2015, 2017) local dv `dv' plan_muestreo
  9.     if `y' >= 2018              local dv estrato upm
 10.     if `hay_area'               local dv `dv' area
 11. 
.     use id_persona anio provincia `dv' using "$raw/empleo`y'.dta", clear
 12. 
.     * --- area: antes de 2000 la ENEMDU es solo urbana ---
.     if !`hay_area' gen byte area = 1
 13.     qui replace area = 1 if missing(area)
 14. 
.     * --- UPM ---
.     if `y' <= 2017 {
 15.         gen str psu_str = trim(ciudad) + "-" + trim(zona) + "-" + trim(sec
> tor)
 16.         local f_psu "ciudad+zona+sector"
 17.     }
 18.     else {
 19.         gen str psu_str = trim(upm)
 20.         local f_psu "upm"
 21.     }
 22. 
.     * --- Estrato ---
.     if `y' >= 2018 {
 23.         gen str est_str = trim(estrato)
 24.         local f_est "estrato"
 25.     }
 26.     else if inrange(`y', 2015, 2017) {
 27.         gen str est_str = trim(plan_muestreo)
 28.         local f_est "plan_muestreo"
 29.     }
 30.     else {
 31.         gen str est_str = trim(provincia) + "-" + string(area, "%1.0f")
 32.         local f_est "provincia x area"
 33.     }
 34. 
.     gen str32 diseno_fuente = "`f_est' / `f_psu'"
 35. 
.     * --- control de calidad del año ---
.     qui count if est_str == "" | psu_str == "" | psu_str == "--"
 36.     local nmiss = r(N)
 37. 
.     qui egen __tp = tag(est_str psu_str)
 38.     qui bysort est_str: egen __k = total(__tp)
 39.     qui egen __te = tag(est_str)
 40.     qui count if __te
 41.     local nest = r(N)
 42.     qui count if __te & __k == 1
 43.     local nsing = r(N)
 44.     qui egen __tu = tag(psu_str)
 45.     qui count if __tu
 46.     local nupm = r(N)
 47.     drop __*
 48. 
.     di as txt "   diseño: `f_est' / `f_psu'"
 49.     di as txt "   estratos = `nest' (con una sola UPM: `nsing') ; UPM = `n
> upm' ; sin diseño = `nmiss'"
 50.     if `nmiss' > 0 di as error "   ATENCION: `nmiss' observaciones sin var
> iables de diseño en `y'"
 51. 
.     keep id_persona anio est_str psu_str diseno_fuente
 52.     append using `acumulado'
 53.     qui save `acumulado', replace
 54. }
