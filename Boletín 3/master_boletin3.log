. 
. di as text "================ STEP 2: Rev 3 -> Rev 3.1 (2000-2006) ===========
> ====="
================ STEP 2: Rev 3 -> Rev 3.1 (2000-2006) ================

. do "$rama/isic3_31.do"

. clear

. 
. * Definicion de rutas globales para facilitar la portabilidad del codigo
. if "`c(username)'" == "vero" global user_root "/Users/vero/Library/CloudStora
> ge/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. else                         global user_root "/Users/santiago/Library/CloudS
> torage/GoogleDrive-observatorio.pobreza@flacso.edu.ec/Mi unidad"

. global bases "$user_root/Bases/ENEMDU/Procesadas/Armonizacion/Variables base/
> Mensuales"

. 
. global isic "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. global out "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. 
. *----------------------------------------------------------------------------
> -
. * STEP 1: Preparar correspondencia CIIU Rev. 3 -> CIIU Rev. 3.1
. *----------------------------------------------------------------------------
> --
. 
. * El archivo .rtf contiene una tabla tipo CSV desde la fila 10.
. * bindquote(nobind) evita que comillas internas en la descripcion corten la i
> mportacion.
. import delimited using "$isic/ISIC3_ISIC31.rtf", clear ///
>         varnames(10) colrange(1:4) stringcols(_all) bindquote(nobind)
(4 vars, 317 obs)

. 
. rename *, lower
  (all newnames==oldnames)

. 
. rename (rev3 rev31) (isic3code isic31code)

. destring parcial3 parcial31, replace ignore("\")
parcial3: all characters numeric; replaced as byte
(1 missing value generated)
parcial31: all characters numeric; replaced as byte
(1 missing value generated)

. 
. replace isic3code = strtrim(isic3code)
(0 real changes made)

. replace isic31code = strtrim(isic31code)
(0 real changes made)

. replace isic3code = subinstr(isic3code, `"""', "", .)
(316 real changes made)

. replace isic31code = subinstr(isic31code, `"""', "", .)
(316 real changes made)

. drop if missing(isic3code) | missing(isic31code) | isic3code == "n/a"
(3 observations deleted)

. 
. replace isic3code = substr("0000" + isic3code, -4, .)
(0 real changes made)

. replace isic31code = substr("0000" + isic31code, -4, .)
(0 real changes made)

. 
. * En codigos con multiples correspondencias se prioriza:
. * 1) correspondencia no parcial, 2) destino no parcial, 3) mismo codigo.
. gen byte exact_match = isic3code == isic31code

. gsort isic3code parcial3 parcial31 -exact_match isic31code

. duplicates drop isic3code, force

Duplicates in terms of isic3code

(22 observations deleted)

. 
. rename isic3code p40_old

. rename isic31code p40

. 
. keep p40_old p40

. tempfile crosswalk_clean_3_31

. save `crosswalk_clean_3_31'
file /var/folders/v8/j2_3wzqd1rqc2l_95p5k_2l00000gn/T//St28152.000001 saved
    as .dta format

. 
. *----------------------------------------------------------------------------
> -
. * STEP 2: Actualizar bases 2000-2006 de CIIU Rev. 3 a Rev. 3.1
. *----------------------------------------------------------------------------
> --
. 
. forval anio = 2000/2006 {
  2. 
.         di "********************************`anio'***************************
> *****"
  3. 
.         capture noisily use "$bases/empleo`anio'.dta", clear
  4. 
.         * Preserva cualquier rama1 preexistente para evitar conflictos al
.         * generar la nueva seccion Rev. 3.1.
.         capture confirm variable rama1
  5.         if !_rc rename rama1 rama1_codigo_orig
  6. 
.         rename rama p40_old
  7.         tostring p40_old, replace force
  8.         replace p40_old = strtrim(p40_old)
  9.         replace p40_old = substr("0000" + p40_old, -4, .) if p40_old != ""
>  & p40_old != "."
 10. 
.         merge m:1 p40_old using `crosswalk_clean_3_31', keep(master match)
 11. 
.         * Lista codigos no mapeados para revision manual.
.         tab p40_old if missing(p40) & p40_old != ""
 12. 
.         rename p40_old rama_old_isic3
 13.         drop _merge
 14. 
.         * Extrae los primeros 2 digitos del nuevo codigo CIIU Rev. 3.1.
.         gen isic2 = substr(p40, 1, 2)
 15.         gen rama_new = ""
 16. 
.         * Mapeo de divisiones a secciones CIIU Rev. 3.1.
.         replace rama_new = "A" if isic2 >= "01" & isic2 <= "02"
 17.         replace rama_new = "B" if isic2 == "05"
 18.         replace rama_new = "C" if isic2 >= "10" & isic2 <= "14"
 19.         replace rama_new = "D" if isic2 >= "15" & isic2 <= "37"
 20.         replace rama_new = "E" if isic2 >= "40" & isic2 <= "41"
 21.         replace rama_new = "F" if isic2 == "45"
 22.         replace rama_new = "G" if isic2 >= "50" & isic2 <= "52"
 23.         replace rama_new = "H" if isic2 == "55"
 24.         replace rama_new = "I" if isic2 >= "60" & isic2 <= "64"
 25.         replace rama_new = "J" if isic2 >= "65" & isic2 <= "67"
 26.         replace rama_new = "K" if isic2 >= "70" & isic2 <= "74"
 27.         replace rama_new = "L" if isic2 == "75"
 28.         replace rama_new = "M" if isic2 == "80"
 29.         replace rama_new = "N" if isic2 == "85"
 30.         replace rama_new = "O" if isic2 >= "90" & isic2 <= "93"
 31.         replace rama_new = "P" if isic2 >= "95" & isic2 <= "97"
 32.         replace rama_new = "Q" if isic2 == "99"
 33. 
.         * Codificacion deterministica: la letra define directamente el numero
.         * (A=1, B=2, ..., Q=17) independiente de las secciones presentes.
.         * strpos retorna 1 cuando la aguja es vacia, asi que se filtra explic
> ito.
.         gen byte rama_final = strpos("ABCDEFGHIJKLMNOPQ", rama_new) if rama_n
> ew != ""
 34.         replace rama_final = . if rama_final == 0
 35. 
.         label define isic31_secciones ///
>                 1 "Agricultura, caza y silvicultura" ///
>                 2 "Pesca" ///
>                 3 "Explotacion de minas y canteras" ///
>                 4 "Industria manufacturera" ///
>                 5 "Electricidad, gas y agua" ///
>                 6 "Construccion" ///
>                 7 "Comercio al por mayor y al por menor; reparacion de vehicu
> los automotores, motocicletas y efectos personales y enseres domesticos" ///
>                 8 "Hoteles y restaurantes" ///
>                 9 "Transporte, almacenamiento y comunicaciones" ///
>                 10 "Intermediacion financiera" ///
>                 11 "Actividades inmobiliarias, empresariales y de alquiler" /
> //
>                 12 "Administracion publica y defensa; seguridad social de afi
> liacion obligatoria" ///
>                 13 "Educacion" ///
>                 14 "Servicios sociales y de salud" ///
>                 15 "Otras actividades de servicios comunitarios, sociales y p
> ersonales" ///
>                 16 "Actividades de los hogares como empleadores y actividades
>  de produccion no diferenciada de los hogares" ///
>                 17 "Organizaciones y organos extraterritoriales", replace
 36. 
.         label values rama_final isic31_secciones
 37.         rename rama_final rama1
 38. 
.         drop isic2 rama_new
 39. 
.         save "$out/empleo`anio'_isic31.dta", replace
 40.         
. }
