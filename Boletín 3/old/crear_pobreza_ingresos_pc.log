. *--- Years requested by source type ---*
. local years_urb 1991 1993 1995 1997 1999

. local years_nac 2001 2003 2005 2007 2009 2011 2013 2015 2017 2019 2021 2023 2
> 025

. local analysis_start 2001

. 
. foreach scope in urb nac {
  2. 
.     if "`scope'" == "urb" {
  3.         local years `years_urb'
  4.     }
  5.     else {
  6.         local years `years_nac'
  7.     }
  8. 
.     foreach y of local years {
  9. 
.         if `y' == 2025 {
 10.             local infile "$user_root/Bases/ENEMDU/Originales/Diciembres/20
> 18-presente/Trimestrales/empleo2025.dta"
 11.         }
 12.         else if "`scope'" == "nac" {
 13.             local infile "$ingresos_pc/Nacional/ing_perca_`y'_`scope'_prec
> ios2000.dta"
 14.         }
 15.         else {
 16.             local infile "$ingresos_pc/ing_perca_`y'_`scope'_precios2000.d
> ta"
 17.         }
 18.         local outfile "`outdir'/ing_perca_`y'_`scope'_precios2000.dta"
 19. 
.         capture confirm file "`infile'"
 20.         if _rc {
 21.             display as error "File not found: `infile'"
 22.             continue
 23.         }
 24. 
.         quietly use `lineas', clear
 25.         quietly keep if anio == `y'
 26. 
.         if _N != 1 {
 27.             display as error "No unique poverty threshold found for year `
> y'"
 28.             error 459
 29.         }
 30. 
.         local lp = linea_pobreza[1]
 31. 
.         use "`infile'", clear
 32. 
.         if `y' >= 1991 & `y' <= 1999 {
 33.             local ingreso_var ingtot_per_deflated
 34.         }
 35.         else if `y' == 2025 {
 36.             local ingreso_var ingpc
 37.         }
 38.         else {
 39.             local ingreso_var ingtot_per
 40.         }
 41. 
.         capture confirm variable `ingreso_var'
 42.         if _rc {
 43.             display as error "Variable `ingreso_var' not found in `infile'
> "
 44.             error 111
 45.         }
 46. 
.         capture confirm variable ing_lab
 47.         if _rc {
 48.             capture confirm variable ing_lab_deflated
 49.             if !_rc {
 50.                 display as text "Variable ing_lab not found in `infile'; u
> sing ing_lab_deflated to create ing_lab."
 51.                 generate double ing_lab = ing_lab_deflated
 52.             }
 53.             else {
 54.                 capture confirm variable ingrl
 55.                 if !_rc {
 56.                     display as text "Variables ing_lab and ing_lab_deflate
> d not found in `infile'; using valid ingrl values to create ing_lab."
 57.                     generate double ing_lab = ingrl if ingrl >= 0 & ingrl 
> < 999999
 58.                 }
 59.                 else {
 60.                     display as text "Variables ing_lab, ing_lab_deflated, 
> and ingrl not found in `infile'; generating missing values."
 61.                     generate double ing_lab = .
 62.                 }
 63.             }
 64.         }
 65. 
.         capture drop pobreza
 66.         capture drop linea_pobreza
 67.         capture drop cobertura_pobreza
 68.         capture drop ingreso_pobreza
 69.         capture drop ingreso_pobreza_var
 70.         capture drop educacion
 71.         capture drop educacion_superior
 72.         
.         capture confirm variable anio
 73.         if _rc {
 74.             generate int anio = `y'
 75.         }
 76.         else {
 77.             replace anio = `y' if missing(anio)
 78.         }
 79. 
.         capture confirm variable sexo
 80.         if _rc {
 81.             capture confirm variable p02
 82.             if !_rc {
 83.                 generate byte sexo = p02
 84.             }
 85.             else {
 86.                 generate byte sexo = .
 87.             }
 88.         }
 89. 
.         capture confirm variable area
 90.         if _rc {
 91.             generate byte area = .
 92.             replace area = 1 if "`scope'" == "urb"
 93.         }
 94. 
.         capture confirm variable nnivins
 95.         if !_rc {
 96.             generate educacion = nnivins
 97.         }
 98.         else {
 99.             capture confirm variable nivinst
100.             if !_rc {
101.                 generate educacion = nivinst
102.             }
103.             else {
104.                 capture confirm variable p10a
105.                 if !_rc {
106.                     generate educacion = p10a
107.                 }
108.                 else {
109.                     generate byte educacion = .
110.                 }
111.             }
112.         }
113. 
.         generate byte educacion_superior = 0
114. 
.         if inrange(`y', 1991, 1999) {
115.             capture confirm variable nivinst
116.             if !_rc {
117.                 replace educacion_superior = 1 if nivinst == 5
118.                 replace educacion_superior = . if missing(nivinst)
119.             }
120.             else {
121.                 replace educacion_superior = .
122.             }
123.         }
124.         else if `y' == 2001 {
125.             capture confirm variable nivinst
126.             if !_rc {
127.                 replace educacion_superior = 1 if inlist(nivinst, 6, 7)
128.                 replace educacion_superior = . if missing(nivinst)
129.             }
130.             else {
131.                 replace educacion_superior = .
132.             }
133.         }
134.         else if inrange(`y', 2003, 2006) {
135.             capture confirm variable nivinst
136.             if !_rc {
137.                 replace educacion_superior = 1 if inlist(nivinst, 9, 10)
138.                 replace educacion_superior = . if missing(nivinst)
139.             }
140.             else {
141.                 replace educacion_superior = .
142.             }
143.         }
144.         else if `y' >= 2007 {
145.             capture confirm variable p10a
146.             if !_rc {
147.                 replace educacion_superior = 1 if inlist(p10a, 9, 10)
148.                 replace educacion_superior = . if missing(p10a)
149.             }
150.             else {
151.                 replace educacion_superior = .
152.             }
153.         }
154. 
.         generate double linea_pobreza = `lp'
155.         generate double ingreso_pobreza = `ingreso_var'
156.         capture confirm variable ingtot_per
157.         if _rc {
158.             generate double ingtot_per = ingreso_pobreza
159.             label variable ingtot_per "Ingreso per capita usado para pobre
> za"
160.         }
161.         generate byte pobreza = (ingreso_pobreza < linea_pobreza) if !miss
> ing(ingreso_pobreza)
162.         generate str3 cobertura_pobreza = "`scope'"
163.         generate str20 ingreso_pobreza_var = "`ingreso_var'"
164. 
.         label variable linea_pobreza "Linea de pobreza anual diciembre (USD)"
165.         label variable ingreso_pobreza "Ingreso usado para pobreza"
166.         label variable ingreso_pobreza_var "Variable de ingreso usada para
>  pobreza"
167.         label variable pobreza "Ingreso per capita bajo linea de pobreza"
168.         label variable cobertura_pobreza "Cobertura de base usada para pob
> reza"
169.         label variable educacion "Nivel de educacion armonizado desde vari
> able original"
170.         label variable educacion_superior "Tiene educacion superior"
171.         label define pobreza_lbl 0 "No pobre" 1 "Pobre", replace
172.         label define educ_sup_lbl 0 "Sin educacion superior" 1 "Con educac
> ion superior", replace
173.         label values pobreza pobreza_lbl
174.         label values educacion_superior educ_sup_lbl
175. 
.         quietly count if pobreza == 1
176.         local n_pobres = r(N)
177.         quietly count if pobreza < .
178.         local n_validos = r(N)
179. 
.         display as text "Year `y' (`scope'): line = " ///
>             as result %9.2f `lp' ///
>             as text ", poor = " ///
>             as result %12.0fc `n_pobres' ///
>             as text " / " ///
>             as result %12.0fc `n_validos'
180. 
.         if `replace_originals' {
181.             save "`infile'", replace
182.         }
183.         else {
184.             save "`outfile'", replace
185.         }
186.     }
187. }
