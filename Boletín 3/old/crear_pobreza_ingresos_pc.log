. do crear_pobreza_ingresos_pc.do 

. *----------------------------------------------------------------------------
> --*
. * Create poverty variable in ENEMDU per-capita income datasets
. *----------------------------------------------------------------------------
> --*
. *
. * Rule:
. *   pobreza = 1 if ingtot_per is below the annual December poverty threshold
. *   pobreza = 0 if ingtot_per is at or above the threshold
. *
. * Data selection:
. *   1991-1999 odd years: urban datasets (_urb)
. *   2001 onwards odd years: national datasets (_nac)
. *
. * By default, the script saves modified copies in:
. *   .../ingresos_pc/con_pobreza
. *
. * To overwrite the original datasets, change replace_originals to 1.
. *----------------------------------------------------------------------------
> --*
. 
. clear all

. set more off

. version 15.1

. set varabbrev off

. 
. global user_root "/Users/vero/Library/CloudStorage/GoogleDrive-observatorio.p
> obreza@flacso.edu.ec/Mi unidad"

. global ingresos_pc "$user_root/Bases/ENEMDU/Procesadas/ingresos_pc"

. global lineas_xlsx "$user_root/Bases/lineas_pobreza/lineas_de_pobreza_histori
> ca.xlsx"

. 
. local replace_originals 0

. local outdir "$ingresos_pc/con_pobreza"

. local historico "`outdir'/ing_perca_pobreza_historico.dta"

. local resumen "`outdir'/evolucion_pobreza.dta"

. local resumen_ing_lab "`outdir'/evolucion_pobreza_ing_lab.dta"

. local resumen_ing_lab_sexo "`outdir'/evolucion_pobreza_ing_lab_sexo.dta"

. local resumen_ing_lab_area "`outdir'/evolucion_pobreza_ing_lab_area.dta"

. local resumen_ing_lab_educ "`outdir'/evolucion_pobreza_ing_lab_educacion_supe
> rior.dta"

. 
. if !`replace_originals' {
.     capture mkdir "`outdir'"
. }

. 
. *--- Import annual December poverty thresholds ---*
. tempfile lineas

. 
. import excel using "$lineas_xlsx", ///
>     sheet("Resumen Anual (Diciembre)") cellrange(A4:D39) clear
(4 vars, 36 obs)

. 
. rename A anio

. rename C linea_pobreza

. keep anio linea_pobreza

. 
. foreach v in anio linea_pobreza {
  2.     capture confirm numeric variable `v'
  3.     if _rc {
  4.         destring `v', replace force
  5.     }
  6. }

. 
. drop if missing(anio) | missing(linea_pobreza)
(0 observations deleted)

. duplicates drop anio, force

Duplicates in terms of anio

(0 observations are duplicates)

. save `lineas', replace
