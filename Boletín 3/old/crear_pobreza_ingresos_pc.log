. foreach scope in urb nac {
  2. 
.     if "`scope'" == "urb" {
  3.         local years `years_urb'
  4.     }
  5.     else {
  6.         local years `years_nac'
  7.     }
  8. 
.     foreach y of local years {
  9. 
.         if `replace_originals' {
 10.             local datafile "$ingresos_pc/ing_perca_`y'_`scope'_precios2000
> .dta"
 11.         }
 12.         else {
 13.             local datafile "`outdir'/ing_perca_`y'_`scope'_precios2000.dta
> "
 14.         }
 15. 
.         capture confirm file "`datafile'"
 16.         if _rc {
 17.             display as error "File not found for append: `datafile'"
 18.             continue
 19.         }
 20. 
.         if `first_file' {
 21.             use "`datafile'", clear
 22.             keep `append_vars'
 23.             local first_file 0
 24.         }
 25.         else {
 26.             tempfile nextfile
 27.             preserve
 28.             use "`datafile'", clear
 29.             keep `append_vars'
 30.             save `nextfile', replace
 31.             restore
 32. 
.             append using `nextfile'
 33.         }
 34.     }
 35. }
