. do 00_master.do 

. *----------------------------------------------------------------------------
> -
. * 00_master.do
. *
. * Ejecuta toda la cadena de armonizacion de ramas de ENEMDU:
. *   1) CIIU Rev. 2  -> Rev. 3.1   (1990-1999)
. *   2) CIIU Rev. 3  -> Rev. 3.1   (2000-2006)
. *   3) CIIU Rev. 3.1 -> Rev. 4    (1991-2012) + pass-through (2013-2025)
. *   4) Tabla descriptiva: % de las ramas mas grandes por anio.
. *----------------------------------------------------------------------------
> -
. 
. clear all

. set more off

. version 16

. 
. global wd "/Users/vero/Documents/Observatorio GH/Observatorio-Desigualdad-Pob
> reza/Boletín 3/2. Armonización de variables/rama"

. 
. cd "$wd"
/Users/vero/Documents/Observatorio GH/Observatorio-Desigualdad-Pobreza/Boletín 
> 3/2. Armonización de variables/rama

. 
. di as text "================ STEP 1: Rev 2 -> Rev 3.1 (1990-1999) ===========
> ====="
================ STEP 1: Rev 2 -> Rev 3.1 (1990-1999) ================

. do "isic2_31.do"

. clear

. 
. * Definicion de rutas globales para facilitar la portabilidad del codigo
. global user_root "/Users/vero/Library/CloudStorage/GoogleDrive-observatorio.p
> obreza@flacso.edu.ec/Mi unidad"

. 
. global bases "$user_root/Bases/ENEMDU/Procesadas/Armonizacion/Variables base/
> Trimestrales"

. 
. global isic "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. global out "$user_root/Bases/ENEMDU/Procesadas/ramas homogeneizadas"

. 
. *----------------------------------------------------------------------------
> -
. * STEP 1: Preparar correspondencia CIIU Rev. 2 -> CIIU Rev. 3.1
. *----------------------------------------------------------------------------
> --
. 
. import delimited using "$isic/ISIC2_ISIC31.txt", clear stringcols(_all)
(5 vars, 562 obs)

. 
. rename (rev2 rev31) (isic2code isic31code)

. destring partial2 partial31, replace ignore("\")
partial2: all characters numeric; replaced as byte
partial31: all characters numeric; replaced as byte

. 
. replace isic2code  = strtrim(isic2code)
(0 real changes made)

. replace isic31code = strtrim(isic31code)
(0 real changes made)

. drop if missing(isic2code) | missing(isic31code)
(0 observations deleted)

. 
. replace isic2code  = substr("0000" + isic2code,  -4, .)
(2 real changes made)

. replace isic31code = substr("0000" + isic31code, -4, .)
(23 real changes made)

. 
. * En codigos con multiples correspondencias se prioriza:
. * 1) correspondencia no parcial, 2) destino no parcial, 3) mismo codigo.
. gen byte exact_match = isic2code == isic31code

. gsort isic2code partial2 partial31 -exact_match isic31code

. duplicates drop isic2code, force

Duplicates in terms of isic2code

(402 observations deleted)

. 
. rename isic2code  p40_old

. rename isic31code p40

. 
. keep p40_old p40

. tempfile crosswalk_clean_2_31

. save `crosswalk_clean_2_31'
file /var/folders/0q/1yz0j50s36s2dbr49xng4lvw0000gn/T//St09872.000001 saved

. 
. *----------------------------------------------------------------------------
> -
. * STEP 2: Actualizar bases 1990-1999 de CIIU Rev. 2 a Rev. 3.1
. *----------------------------------------------------------------------------
> --
. 
. forval anio = 1990/1999 {
  2. 
.         di "********************************`anio'***************************
> *****"
  3. 
.         * 1990 fue grabado en latin1; los demas anos abren sin problema.
.         capture noisily use "$bases/empleo`anio'.dta", clear
  4.         if _rc {
  5.                 di as error "  AVISO: empleo`anio'.dta no se pudo abrir di
> rectamente."
  6.                 di as error "  Intente: unicode encoding set Latin1 ; unic
> ode translate ""$bases/empleo`anio'.dta"""
  7.                 continue
  8.         }
  9. 
.         * Algunos anos (p.ej. 1999) ya traen una variable rama1 con el codigo
>  de 4
.         * digitos; se preserva como respaldo para evitar conflictos de nombre
> s.
.         capture confirm variable rama1
 10.         if !_rc rename rama1 rama1_codigo_orig
 11. 
.         rename rama p40_old
 12.         tostring p40_old, replace force
 13.         replace p40_old = strtrim(p40_old)
 14.         replace p40_old = substr("0000" + p40_old, -4, .) if p40_old != ""
>  & p40_old != "."
 15. 
.         merge m:1 p40_old using `crosswalk_clean_2_31', keep(master match)
 16. 
.         * Lista codigos no mapeados para revision manual.
.         tab p40_old if missing(p40) & p40_old != ""
 17. 
.         rename p40_old rama_old_isic2
 18.         drop _merge
 19. 
.         * Extrae los primeros 2 digitos del nuevo codigo CIIU Rev. 3.1.
.         gen isic2 = substr(p40, 1, 2)
 20.         gen rama_new = ""
 21. 
.         * Mapeo de divisiones a secciones CIIU Rev. 3.1.
.         replace rama_new = "A" if isic2 >= "01" & isic2 <= "02"
 22.         replace rama_new = "B" if isic2 == "05"
 23.         replace rama_new = "C" if isic2 >= "10" & isic2 <= "14"
 24.         replace rama_new = "D" if isic2 >= "15" & isic2 <= "37"
 25.         replace rama_new = "E" if isic2 >= "40" & isic2 <= "41"
 26.         replace rama_new = "F" if isic2 == "45"
 27.         replace rama_new = "G" if isic2 >= "50" & isic2 <= "52"
 28.         replace rama_new = "H" if isic2 == "55"
 29.         replace rama_new = "I" if isic2 >= "60" & isic2 <= "64"
 30.         replace rama_new = "J" if isic2 >= "65" & isic2 <= "67"
 31.         replace rama_new = "K" if isic2 >= "70" & isic2 <= "74"
 32.         replace rama_new = "L" if isic2 == "75"
 33.         replace rama_new = "M" if isic2 == "80"
 34.         replace rama_new = "N" if isic2 == "85"
 35.         replace rama_new = "O" if isic2 >= "90" & isic2 <= "93"
 36.         replace rama_new = "P" if isic2 >= "95" & isic2 <= "97"
 37.         replace rama_new = "Q" if isic2 == "99"
 38. 
.         * Codificacion deterministica: la letra define directamente el numero
.         * (A=1, B=2, ..., Q=17) independiente de las secciones presentes.
.         * strpos retorna 1 cuando la aguja es vacia, asi que se filtra explic
> ito.
.         gen byte rama_final = strpos("ABCDEFGHIJKLMNOPQ", rama_new) if rama_n
> ew != ""
 39.         replace rama_final = . if rama_final == 0
 40. 
.         label define isic31_secciones ///
>                 1 "Agricultura, caza y silvicultura" ///
>                 2 "Pesca" ///
>                 3 "Explotacion de minas y canteras" ///
>                 4 "Industria manufacturera" ///
>                 5 "Electricidad, gas y agua" ///
>                 6 "Construccion" ///
>                 7 "Comercio al por mayor y al por menor; reparacion de vehicu
> los automotores, motocicletas y efectos personales y enseres domesticos" ///
>                 8 "Hoteles y restaurantes" ///
>                 9 "Transporte, almacenamiento y comunicaciones" ///
>                 10 "Intermediacion financiera" ///
>                 11 "Actividades inmobiliarias, empresariales y de alquiler" /
> //
>                 12 "Administracion publica y defensa; seguridad social de afi
> liacion obligatoria" ///
>                 13 "Educacion" ///
>                 14 "Servicios sociales y de salud" ///
>                 15 "Otras actividades de servicios comunitarios, sociales y p
> ersonales" ///
>                 16 "Actividades de los hogares como empleadores y actividades
>  de produccion no diferenciada de los hogares" ///
>                 17 "Organizaciones y organos extraterritoriales", replace
 41. 
.         label values rama_final isic31_secciones
 42.         rename rama_final rama1
 43. 
.         drop isic2 rama_new
 44. 
.         save "$out/empleo`anio'_isic31.dta", replace
 45. 
. }
