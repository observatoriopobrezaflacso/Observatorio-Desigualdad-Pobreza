. 
. di as result _n "===================================================================="

====================================================================

. di as result    " (1) CRECIMIENTO: D$hi_decile vs D$lo_decile -- $shock_lab"
 (1) CRECIMIENTO: D10 vs D6 -- covid | pre 2019 | orden a=2017 b=2015-2017 | base 2018 | origen D6-D10 | principal lg | solo 2019 vs 2020 |
>  winsorizado p1

. di as result    " dependiente principal: $main_lab"
 dependiente principal: log-crecimiento  ln(y_t) - ln(y_base)

. di as result    " robustez (7.4)       : $rob_lab"
 robustez (7.4)       : crecimiento  y_t/y_base - 1  (winsorizado p1)

. di as result    "===================================================================="
====================================================================

. 
. local si = 0

. foreach s of global samples {
  2.     local si = `si' + 1
  3. 
.     di as result _n "%%%%%%%%%%%%%% MUESTRA: `s' %%%%%%%%%%%%%%"
  4. 
.     local c = 0
  5.     foreach v of global inc_vars {
  6.         foreach j in a b {
  7.             local c = `c' + 1
  8. 
.             di as result _n "############ `v'  --  definicion de t0: (`j') ############"
  9. 
.             * ---- 7.1 Solo los dos deciles de interes (dif-en-dif limpio) --
.             di as result _n "-- [A1] anio x decil, solo D$lo_decile y D$hi_decile --"
 10.             capture noisily reg `ymain'_`j'_`v'                               ///
>                 ib${pre_year}.anio##ib${lo_decile}.decil0_`j'_`v'             ///
>                 if muestra == `si' & inlist(decil0_`j'_`v', $lo_decile, $hi_decile), ///
>                 vce(cluster id)
 11. 
.             if !_rc {
 12.                 local rr = 0
 13.                 foreach y of global post_years {
 14.                     local rr = `rr' + 1
 15.                     local row = (`si' - 1) * $n_post + `rr'
 16.                     capture lincom `y'.anio#${hi_decile}.decil0_`j'_`v'
 17.                     if !_rc {
 18.                         matrix A1_dd[`row', `c'] = r(estimate)
 19.                         matrix A1_se[`row', `c'] = r(se)
 20.                         matrix A1_p[`row', `c']  = 2*ttail(r(df), abs(r(estimate)/r(se)))
 21.                     }
 22.                 }
 23.                 local rr = 0
 24.                 foreach y of global out_years {
 25.                     local rr = `rr' + 1
 26.                     local row = (`si' - 1) * $n_out_years + `rr'
 27.                     if `y' == $pre_year capture lincom ${hi_decile}.decil0_`j'_`v'
 28.                     else capture lincom ${hi_decile}.decil0_`j'_`v' + `y'.anio#${hi_decile}.decil0_`j'_`v'
 29.                     if !_rc matrix A1_gp[`row', `c'] = r(estimate)
 30.                 }
 31. 
.                 * ---- 7.2 Version 2x2 (post agrupado) ---------------------
.                 * Con un solo anio post (modo de dos anios) es literalmente la
.                 * misma regresion que 7.1, asi que no se repite.
.                 if $n_post > 1 {
 32.                     di as result _n "-- [A1] 2x2: post x D$hi_decile --"
 33.                     capture noisily reg `ymain'_`j'_`v' i.post##i.hi_`j'_`v'  ///
>                         if muestra == `si' & inlist(decil0_`j'_`v', $lo_decile, $hi_decile), ///
>                         vce(cluster id)
 34.                 }
 35.                 else di as text _n "-- [A1] 2x2 omitido: con un solo anio post coincide con 7.1 --"
 36. 
.                 * ---- 7.3 Todos los deciles de origen de la muestra --------
.                 di as result _n "-- [A1] Deciles de origen $keep_dec_lo-$keep_dec_hi, base D$lo_decile --"
 37.                 capture noisily reg `ymain'_`j'_`v'                           ///
>                     ib${pre_year}.anio##ib${lo_decile}.decil0_`j'_`v'         ///
>                     if muestra == `si', vce(cluster id)
 38. 
.                 * ---- 7.4 Robustez: la otra medida del crecimiento --------
.                 di as result _n "-- [A1] Robustez: $rob_lab --"
 39.                 capture noisily reg `yrob'_`j'_`v'                            ///
>                     ib${pre_year}.anio##ib${lo_decile}.decil0_`j'_`v'         ///
>                     if muestra == `si' & inlist(decil0_`j'_`v', $lo_decile, $hi_decile), ///
>                     vce(cluster id)
 40.                 if !_rc {
 41.                     local rr = 0
 42.                     foreach y of global post_years {
 43.                         local rr = `rr' + 1
 44.                         local row = (`si' - 1) * $n_post + `rr'
 45.                         capture lincom `y'.anio#${hi_decile}.decil0_`j'_`v'
 46.                         if !_rc {
 47.                             matrix A1R_dd[`row', `c'] = r(estimate)
 48.                             matrix A1R_se[`row', `c'] = r(se)
 49.                             matrix A1R_p[`row', `c']  = 2*ttail(r(df), abs(r(estimate)/r(se)))
 50.                         }
 51.                     }
 52.                 }
 53.             }
 54.             else di as error "  regresion no estimable para `v'_`j' en la muestra `s'"
 55.         }
 56.     }
 57. }

