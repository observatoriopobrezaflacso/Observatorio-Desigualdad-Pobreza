. di as result _n "===================================================================="

====================================================================
. di as result    " (6) HETEROGENEIDAD -- $shock_lab"
 (6) HETEROGENEIDAD -- covid | pre 2019 | orden a=2017 b=2015-2017 | base 2018 | origen D6-D10 | principal lg | solo 2019 vs 2020 | winsori
> zado p1
. di as result    "     dimensiones: `dims'   comparaciones: D$hi_decile vs D($lo_list)"
     dimensiones:  edad sexo civil   comparaciones: D10 vs D(6 7 8 9)
. di as result    "     resultado: $main_lab"
     resultado: log-crecimiento  ln(y_t) - ln(y_base)
. di as result    "===================================================================="
====================================================================
. 
. tempname PH PK
. postfile `PH' str16 pair str6 dim byte muestra int contraste int anio int nivel ///
>     str24 nivel_lab byte stat double value using "$work/${fstem}_het.dta", replace
(file D:/DTO_ESTUDIOS_E1/B_INVESTIGADORES_EXTERNOS/2025.12.01_Santiago_Valdivieso//Proyectos/Impacto
    shocks/data/movilidad_v2/covid_2p_w1_het.dta not found)
. postfile `PK' str16 pair str6 dim byte muestra int decil int nivel ///
>     str24 nivel_lab byte stat double value using "$work/${fstem}_het_comp.dta", replace
(file D:/DTO_ESTUDIOS_E1/B_INVESTIGADORES_EXTERNOS/2025.12.01_Santiago_Valdivieso//Proyectos/Impacto
    shocks/data/movilidad_v2/covid_2p_w1_het_comp.dta not found)
. 
. foreach d of local dims {
  2.     di as result _n "############ dimension: `d' ############"
  3.     local si = 0
  4.     foreach s of global samples {
  5.         local si = `si' + 1
  6.         foreach v of global inc_vars {
  7.             foreach j in a b {
  8.                 local pl "`v'_`j'"
  9.                 local yv "`ymain'_`j'_`v'"
 10.                 local dv "decil0_`j'_`v'"
 11. 
.                 quietly levelsof het_`d' if muestra == `si' & !missing(`dv', `yv'), local(levs)
 12.                 if "`levs'" == "" continue
 13.                 local base : word 1 of `levs'
 14. 
.                 * ---- composicion en el anio pre --------------------------
.                 forvalues dd = $keep_dec_lo/$keep_dec_hi {
 15.                     quietly count if muestra == `si' & anio == $pre_year & `dv' == `dd' ///
>                         & !missing(`yv', het_`d')
 16.                     local ntot = r(N)
 17.                     if `ntot' == 0 continue
 18.                     foreach k of local levs {
 19.                         local lab : label (het_`d') `k'
 20.                         quietly count if muestra == `si' & anio == $pre_year & `dv' == `dd' ///
>                             & !missing(`yv') & het_`d' == `k'
 21.                         post `PK' ("`pl'") ("`d'") (`si') (`dd') (`k') ("`lab'") (1) (r(N) / `ntot')
 22.                         post `PK' ("`pl'") ("`d'") (`si') (`dd') (`k') ("`lab'") (2) (r(N))
 23.                     }
 24.                 }
 25. 
.                 * ---- dif-en-dif por grupo, contra cada decil --------------
.                 foreach c of global lo_list {
 26.                     capture quietly reg `yv'                                          ///
>                         ib${pre_year}.anio##ib`c'.`dv'##ib`base'.het_`d'              ///
>                         if muestra == `si' & inlist(`dv', `c', $hi_decile) & !missing(het_`d'), ///
>                         vce(cluster id)
 27.                     if _rc {
 28.                         di as error "  no estimable: `s' | `pl' | `d' | D`c'"
 29.                         continue
 30.                     }
 31.                     tempvar es
 32.                     quietly gen byte `es' = e(sample)
 33.                     foreach y of global post_years {
 34.                         local line ""
 35.                         foreach k of local levs {
 36.                             local lab : label (het_`d') `k'
 37.                             if `k' == `base' capture quietly lincom `y'.anio#${hi_decile}.`dv'
 38.                             else capture quietly lincom `y'.anio#${hi_decile}.`dv' + ///
>                                                          `y'.anio#${hi_decile}.`dv'#`k'.het_`d'
 39.                             if !_rc {
 40.                                 post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (1) (r(estimate))
 41.                                 post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (2) (r(se))
 42.                                 post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (3) ///
>                                     (2*ttail(r(df), abs(r(estimate)/r(se))))
 43.                                 local _b : display %7.4f r(estimate)
 44.                                 local line "`line'  `lab' `_b'"
 45.                             }
 46.                             if `k' != `base' {
 47.                                 capture quietly lincom `y'.anio#${hi_decile}.`dv'#`k'.het_`d'
 48.                                 if !_rc {
 49.                                     post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (4) (r(estimate))
 50.                                     post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (5) (r(se))
 51.                                     post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (6) ///
>                                         (2*ttail(r(df), abs(r(estimate)/r(se))))
 52.                                 }
 53.                             }
 54.                             quietly count if `es' & het_`d' == `k'
 55.                             post `PH' ("`pl'") ("`d'") (`si') (`c') (`y') (`k') ("`lab'") (7) (r(N))
 56.                         }
 57.                         di as text "  `s' | `pl' | D$hi_decile vs D`c' | `y':`line'"
 58.                     }
 59.                     drop `es'
 60.                 }
 61.             }
 62.         }
 63.     }
 64. }

