> covid/dos_anios/winsorized/regresiones/A2_movilidad_relativa_covid.log
  log type:  text
 opened on:   5 Oct 2026, 13:45:28

. 
. di as result _n "===================================================================="

====================================================================

. di as result    " (2) MOVILIDAD RELATIVA (cambios de decil) -- $shock_lab"
 (2) MOVILIDAD RELATIVA (cambios de decil) -- covid | pre 2019 | orden a=2017 b=2015-2017 | base 2018 | origen D6-D10 | principal lg | solo
>  2019 vs 2020 | winsorizado p1

. di as result    "===================================================================="
====================================================================

. 
. local si = 0

. foreach s of global samples {
  2.     local si = `si' + 1
  3. 
.     di as result _n "%%%%%%%%%%%%%% MUESTRA: `s' %%%%%%%%%%%%%%"
  4. 
.     local c = 0
  5.     foreach v of global inc_vars {
  6.         foreach j in a b {
  7.             local c = `c' + 1
  8. 
.             di as result _n "############ `v'  --  definicion de t0: (`j') ############"
  9. 
.             di as result _n "-- [A2] Magnitud: |delta decil| por anio (base $pre_year) --"
 10.             capture noisily reg adec_`j'_`v' ib${pre_year}.anio ///
>                 if muestra == `si', vce(cluster id)
 11.             if !_rc {
 12.                 local rr = 0
 13.                 foreach y of global post_years {
 14.                     local rr = `rr' + 1
 15.                     local row = (`si' - 1) * $n_post + `rr'
 16.                     capture lincom `y'.anio
 17.                     if !_rc {
 18.                         matrix A2_rdd[`row', `c'] = r(estimate)
 19.                         matrix A2_rse[`row', `c'] = r(se)
 20.                         matrix A2_rp[`row', `c']  = 2*ttail(r(df), abs(r(estimate)/r(se)))
 21.                     }
 22.                 }
 23.             }
 24. 
.             di as result _n "-- [A2] Direccion: probabilidad de subir de decil --"
 25.             capture noisily reg up_`j'_`v' ib${pre_year}.anio ///
>                 if muestra == `si', vce(cluster id)
 26. 
.             di as result _n "-- [A2] Direccion: probabilidad de bajar de decil --"
 27.             capture noisily reg down_`j'_`v' ib${pre_year}.anio ///
>                 if muestra == `si', vce(cluster id)
 28. 
.             di as result _n "-- [A2] Movimiento neto por decil de origen --"
 29.             capture noisily reg ddec_`j'_`v'                          ///
>                 ib${pre_year}.anio##ib${lo_decile}.decil0_`j'_`v'     ///
>                 if muestra == `si', vce(cluster id)
 30. 
.             di as result _n "-- [A2] Persistencia rango-rango en deciles, por anio --"
 31.             di as text     "   pendiente mas alta = mas persistencia = MENOS movilidad"
 32.             capture noisily reg decil_`v' ib${pre_year}.anio##c.decil0_`j'_`v' ///
>                 if muestra == `si', vce(cluster id)
 33.             if !_rc {
 34.                 local yi = 0
 35.                 foreach y of global out_years {
 36.                     local yi = `yi' + 1
 37.                     local row = (`si' - 1) * $n_out_years + `yi'
 38.                     if `y' == $pre_year capture lincom c.decil0_`j'_`v'
 39.                     else capture lincom c.decil0_`j'_`v' + `y'.anio#c.decil0_`j'_`v'
 40.                     if !_rc matrix A2_rr[`row', `c'] = r(estimate)
 41.                 }
 42.             }
 43. 
.             di as result _n "-- [A2] Persistencia rango-rango en percentiles --"
 44.             capture noisily reg pctl_`v' ib${pre_year}.anio##c.pctl0_`j'_`v' ///
>                 if muestra == `si', vce(cluster id)
 45.         }
 46.     }
 47. }

