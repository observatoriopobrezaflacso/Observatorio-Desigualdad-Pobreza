      name:  movlog
       log:  D:/DTO_ESTUDIOS_E1/B_INVESTIGADORES_EXTERNOS/2025.12.01_Santiago_Valdivieso//Proyectos/Impacto shocks/resultados/movilidad_v2/
> covid/dos_anios/winsorized/regresiones/A3_permanencia_extremos_covid.log
  log type:  text
 opened on:   5 Oct 2026, 13:47:52

. 
. di as result _n "===================================================================="

====================================================================

. di as result    " (3) PERMANENCIA EN LOS EXTREMOS -- $shock_lab"
 (3) PERMANENCIA EN LOS EXTREMOS -- covid | pre 2019 | orden a=2017 b=2015-2017 | base 2018 | origen D6-D10 | principal lg | solo 2019 vs 2
> 020 | winsorizado p1

. di as result    "===================================================================="
====================================================================

. 
. local si = 0

. foreach s of global samples {
  2.     local si = `si' + 1
  3. 
.     di as result _n "%%%%%%%%%%%%%% MUESTRA: `s' %%%%%%%%%%%%%%"
  4. 
.     local c = 0
  5.     foreach v of global inc_vars {
  6.         foreach j in a b {
  7.             local c = `c' + 1
  8. 
.             di as result _n "############ `v'  --  definicion de t0: (`j') ############"
  9. 
.             foreach ext in top bot {
 10. 
.                 if "`ext'" == "top" local decl = $top_decile
 11.                 if "`ext'" == "bot" local decl = $bot_decile
 12. 
.                 di as result _n "-- [A3] P(seguir en D`decl' | origen D`decl') -- MPL base $pre_year"
 13.                 capture noisily reg `ext'_`j'_`v' ib${pre_year}.anio ///
>                     if muestra == `si', vce(cluster id)
 14.                 if !_rc {
 15.                     local rr = 0
 16.                     foreach y of global post_years {
 17.                         local rr = `rr' + 1
 18.                         local row = (`si' - 1) * $n_post + `rr'
 19.                         capture lincom `y'.anio
 20.                         if !_rc {
 21.                             if "`ext'" == "top" {
 22.                                 matrix A3_tdd[`row', `c'] = r(estimate)
 23.                                 matrix A3_tse[`row', `c'] = r(se)
 24.                                 matrix A3_tp[`row', `c']  = 2*ttail(r(df), abs(r(estimate)/r(se)))
 25.                             }
 26.                             else {
 27.                                 matrix A3_bdd[`row', `c'] = r(estimate)
 28.                                 matrix A3_bse[`row', `c'] = r(se)
 29.                                 matrix A3_bp[`row', `c']  = 2*ttail(r(df), abs(r(estimate)/r(se)))
 30.                             }
 31.                         }
 32.                     }
 33.                 }
 34. 
.                 di as result _n "   Logit + efectos marginales promedio:"
 35.                 capture noisily logit `ext'_`j'_`v' ib${pre_year}.anio ///
>                     if muestra == `si', vce(cluster id)
 36.                 if !_rc capture noisily margins, dydx(anio)
 37.             }
 38.         }
 39.     }
 40. }

