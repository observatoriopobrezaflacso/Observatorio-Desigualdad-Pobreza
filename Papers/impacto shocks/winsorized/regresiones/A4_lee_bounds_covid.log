. di as result _n "===================================================================="

====================================================================
. di as result    " (4) COTAS DE LEE + IC DE IMBENS-MANSKI -- muestra NO balanceada"
 (4) COTAS DE LEE + IC DE IMBENS-MANSKI -- muestra NO balanceada
. di as result    "     $shock_lab"
     covid | pre 2019 | orden a=2017 b=2015-2017 | base 2018 | origen D6-D10 | principal lg | solo 2019 vs 2020 | winsorizado p1
. di as result    "     outcomes: $LEE_ALL"
     outcomes: g lg ddec adec up down top bot
. di as result    "     EE de las cotas: $im_se" _continue
     EE de las cotas: reg. if "$im_se" == "boot" di as result "  ($im_reps replicas, bootstrap de personas)"
. else                  di as result "  (regresion recortada, agrupada por persona)"
  (regresion recortada, agrupada por persona)
. di as result    "     alpha del IC  : $im_alpha"
     alpha del IC  : 0.05
. di as result    "===================================================================="
====================================================================
. 
. local c = 0
. foreach v of global inc_vars {
  2.     foreach j in a b {
  3.         local c = `c' + 1
  4. 
.         di as result _n "############ `v'  --  definicion de t0: (`j') ############"
  5. 
.         use "$work/${fstem}_analysis.dta", clear
  6.         keep if muestra == 1                      // solo la NO balanceada
  7.         keep if !missing(decil0_`j'_`v')          // y solo D$keep_dec_lo-D$keep_dec_hi
  8. 
.         quietly count
  9.         if r(N) == 0 {
 10.             di as error "  sin observaciones para `v'_`j': se saltea"
 11.             continue
 12.         }
 13. 
.         * ---- 10.2 Diagnostico de atricion --------------------------------
.         bysort id (anio): gen byte _fid = _n == 1
 14.         quietly count if _fid
 15.         local nrisk_all = r(N)
 16.         di as text "   personas en riesgo (con decil de origen): " as result `nrisk_all'
 17. 
.         local yi = 0
 18.         foreach y of global out_years {
 19.             local yi = `yi' + 1
 20.             quietly count if anio == `y' & !missing(gw_`j'_`v')
 21.             if `nrisk_all' > 0 matrix A4_rt[`yi', `c'] = r(N) / `nrisk_all'
 22.         }
 23. 
.         local di = 0
 24.         forvalues d = $keep_dec_lo/$keep_dec_hi {
 25.             local di = `di' + 1
 26.             quietly count if _fid & decil0_`j'_`v' == `d'
 27.             local nrisk_d = r(N)
 28.             local yi = 0
 29.             foreach y of global out_years {
 30.                 local yi = `yi' + 1
 31.                 local row = (`di' - 1) * $n_out_years + `yi'
 32.                 quietly count if anio == `y' & decil0_`j'_`v' == `d' & !missing(gw_`j'_`v')
 33.                 if `nrisk_d' > 0 matrix A4_rtd[`row', `c'] = r(N) / `nrisk_d'
 34.             }
 35.         }
 36.         drop _fid
 37. 
.         * ---- 10.3 Pass principal: cotas y EE de regresion ----------------
.         lee_all, vname(`v') jdef(`j') idvar(id) se log
 38.         matrix LB = r(B)
 39.         matrix LS = r(S)
 40. 
.         * ---- 10.4 Bootstrap de personas para los EE (opcional) -----------
.         if "$im_se" == "boot" {
 41. 
.             di as result _n "-- [A4] bootstrap de personas: $im_reps replicas --"
 42.             di as text    "   en cada replica se remuestrean personas con reemplazo"
 43.             di as text    "   y se RECALCULA el recorte, asi que la variabilidad de q entra"
 44. 
.             tempfile cellf idsf
 45.             quietly save "`cellf'", replace
 46.             preserve
 47.                 quietly bysort id: keep if _n == 1
 48.                 keep id
 49.                 quietly save "`idsf'", replace
 50.             restore
 51. 
.             matrix BS1 = J($n_lee, 1, 0)      // suma
 52.             matrix BS2 = J($n_lee, 1, 0)      // suma de cuadrados
 53.             matrix BSN = J($n_lee, 1, 0)      // replicas validas
 54. 
.             local nbad = 0
 55.             forvalues b = 1/$im_reps {
 56.                 quietly {
 57.                     use "`idsf'", clear
 58.                     bsample
 59.                     gen long bid = _n
 60.                     joinby id using "`cellf'"
 61.                 }
 62.                 capture quietly lee_all, vname(`v') jdef(`j') idvar(bid)
 63.                 if _rc {
 64.                     local nbad = `nbad' + 1
 65.                     continue
 66.                 }
 67.                 matrix Bb = r(B)
 68.                 forvalues k = 1/$n_lee {
 69.                     if !missing(Bb[`k', 1]) {
 70.                         matrix BS1[`k', 1] = BS1[`k', 1] + Bb[`k', 1]
 71.                         matrix BS2[`k', 1] = BS2[`k', 1] + Bb[`k', 1]^2
 72.                         matrix BSN[`k', 1] = BSN[`k', 1] + 1
 73.                     }
 74.                 }
 75.                 if mod(`b', 25) == 0 di as text "   ... replica `b' de $im_reps"
 76.             }
 77.             if `nbad' > 0 di as error "   replicas que fallaron por completo: `nbad'"
 78. 
.             * SD entre replicas -> reemplaza a los EE de regresion
.             forvalues k = 1/$n_lee {
 79.                 scalar _nn = BSN[`k', 1]
 80.                 if _nn > 1 {
 81.                     scalar _vv = (BS2[`k', 1] - BS1[`k', 1]^2 / _nn) / (_nn - 1)
 82.                     if _vv > 0 matrix LS[`k', 1] = sqrt(_vv)
 83.                     else       matrix LS[`k', 1] = .
 84.                 }
 85.                 else matrix LS[`k', 1] = .
 86.             }
 87.             capture scalar drop _nn _vv
 88. 
.             * volver a los datos reales de la celda
.             use "`cellf'", clear
 89.         }
 90. 
.         * ---- 10.5 IC de Imbens-Manski -------------------------------------
.         local LO "$LEE_ORDER"
 91.         foreach o of global LEE_ALL {
 92.             forvalues rr = 1/$n_post {
 93. 
.                 local kL : list posof "`o'_lo_`rr'" in LO
 94.                 local kU : list posof "`o'_hi_`rr'" in LO
 95.                 if `kL' == 0 | `kU' == 0 continue
 96. 
.                 scalar _bL = LB[`kL', 1]
 97.                 scalar _bU = LB[`kU', 1]
 98.                 scalar _sL = LS[`kL', 1]
 99.                 scalar _sU = LS[`kU', 1]
100. 
.                 matrix A4L_`o'[`rr', `c']  = _bL
101.                 matrix A4H_`o'[`rr', `c']  = _bU
102.                 matrix A4SL_`o'[`rr', `c'] = _sL
103.                 matrix A4SU_`o'[`rr', `c'] = _sU
104. 
.                 if $do_im == 1 & !missing(_bL) & !missing(_bU) ///
>                    & !missing(_sL) & !missing(_sU) {
105.                     scalar _smax = max(_sL, _sU)
106.                     im_c, delta(`=_bU - _bL') smax(`=_smax') alpha($im_alpha)
107.                     scalar _cf = r(c)
108.                     if !missing(_cf) {
109.                         matrix A4CF_`o'[`rr', `c'] = _cf
110.                         matrix A4CL_`o'[`rr', `c'] = _bL - _cf * _sL
111.                         matrix A4CU_`o'[`rr', `c'] = _bU + _cf * _sU
112.                     }
113.                 }
114.             }
115.         }
116.         capture scalar drop _bL _bU _sL _sU _smax _cf
117. 
.         di as result _n "-- [A4] cotas e IC de `v'_`j' guardados --"
118.         local rr = 0
119.         foreach y of global post_years {
120.             local rr = `rr' + 1
121.             local kL : list posof "g_lo_`rr'" in LO
122.             local kU : list posof "g_hi_`rr'" in LO
123.             if `kL' > 0 & `kU' > 0 {
124.                 di as text "   `y'  g: [" %7.4f LB[`kL',1] ", " %7.4f LB[`kU',1] "]" ///
>                     "   IC$im_alpha: [" %7.4f A4CL_g[`rr',`c'] ", " %7.4f A4CU_g[`rr',`c'] "]" ///
>                     "   c = " %5.3f A4CF_g[`rr',`c']
125.             }
126.         }
127. 
.         * ---- 10.6 Pendientes rango-rango: RANGO DE SENSIBILIDAD ----------
.         * No son cotas de Lee (una pendiente no es una media ni una diferencia
.         * de medias, asi que el recorte direccional no la acota). Se recorta
.         * simetricamente por arriba y por abajo y se reporta el rango que eso
.         * genera, como diagnostico de cuanto puede mover la atricion a la
.         * pendiente. Sin IC: no seria un IC de nada bien definido.
.         *   rr  = pendiente en DECILES     (decil_t sobre decil_t0)
.         *   rrp = pendiente en PERCENTILES (pctl_t  sobre pctl_t0)
.         if $do_lee_all == 1 {
128.             foreach esc in rr rrp {
129. 
.                 if "`esc'" == "rr" {
130.                     local yv  decil_`v'
131.                     local xv  decil0_`j'_`v'
132.                     local etq "deciles"
133.                 }
134.                 else {
135.                     local yv  pctl_`v'
136.                     local xv  pctl0_`j'_`v'
137.                     local etq "percentiles"
138.                 }
139. 
.                 di as result _n "-- [A4] rango-rango en `etq': SENSIBILIDAD (no es cota de Lee) --"
140.                 capture drop _sgn
141.                 gen byte _sgn = 1
142.                 lee_flags `yv', dec0(decil0_`j'_`v') sgn(_sgn) id(id)
143.                 foreach cota in lo hi {
144.                     di as result _n "   ... recorte `cota'"
145.                     capture noisily reg `yv'                               ///
>                         ib${pre_year}.anio##c.`xv'                         ///
>                         if lee_`cota', vce(cluster id)
146.                     if !_rc {
147.                         local yi = 0
148.                         foreach y of global out_years {
149.                             local yi = `yi' + 1
150.                             if `y' == $pre_year capture lincom c.`xv'
151.                             else capture lincom c.`xv' + `y'.anio#c.`xv'
152.                             if !_rc {
153.                                 if "`cota'" == "lo" matrix A4L_`esc'[`yi', `c'] = r(estimate)
154.                                 if "`cota'" == "hi" matrix A4H_`esc'[`yi', `c'] = r(estimate)
155.                             }
156.                         }
157.                     }
158.                     else di as error "   no estimable: `v'_`j' rango-rango `etq' recorte `cota'"
159.                 }
160.                 capture drop lee_lo
161.                 capture drop lee_hi
162.                 capture drop lee_ret
163.                 capture drop _sgn
164.             }
165.         }
166.     }
167. }

