. di as result _n "== (1b) D$hi_decile contra cada decil de $lo_list -- $main_lab =="

== (1b) D10 contra cada decil de 6 7 8 9 -- log-crecimiento  ln(y_t) - ln(y_base) ==

. 
. local si = 0

. foreach s of global samples {
  2.     local si = `si' + 1
  3.     foreach v of global inc_vars {
  4.         foreach j in a b {
  5.             local pl "`v'_`j'"
  6.             foreach c of global lo_list {
  7.                 capture quietly reg `ymain'_`j'_`v'                           ///
>                     ib${pre_year}.anio##ib`c'.decil0_`j'_`v'                   ///
>                     if muestra == `si' & inlist(decil0_`j'_`v', `c', $hi_decile), ///
>                     vce(cluster id)
  8.                 if _rc continue
  9.                 local nobs = e(N)
 10.                 local line ""
 11.                 foreach y of global post_years {
 12.                     capture quietly lincom `y'.anio#${hi_decile}.decil0_`j'_`v'
 13.                     if _rc continue
 14.                     post `PD' ("`pl'") (`si') (`c') (`y') (1) (r(estimate))
 15.                     post `PD' ("`pl'") (`si') (`c') (`y') (2) (r(se))
 16.                     post `PD' ("`pl'") (`si') (`c') (`y') (3) (2*ttail(r(df), abs(r(estimate)/r(se))))
 17.                     post `PD' ("`pl'") (`si') (`c') (`y') (4) (`nobs')
 18.                     local _b : display %7.4f r(estimate)
 19.                     local _e : display %6.4f r(se)
 20.                     local line "`line'  `y': `_b' (`_e')"
 21.                 }
 22.                 di as text "  `s' | `pl' | D$hi_decile vs D`c':`line'"
 23.             }
 24.         }
 25.     }
 26. }
