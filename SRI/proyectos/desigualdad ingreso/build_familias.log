.     rename ci a
.     keep a b
.     preserve
.         rename a _t_
.         rename b a
.         rename _t_ b
.         qui save "$tmp/_e2.dta", replace
.     restore
.     append using "$tmp/_e2.dta"
.     qui duplicates drop a b, force
.     qui count
.     di as res _n "kinship edges (both directions): " %12.0fc r(N)

kinship edges (both directions):      793,156
.     qui save "$tmp/_edges.dta", replace
. 
.     use "$tmp/_pers.dta", clear
.     keep ci
.     gen double lab = ci
.     qui save "$tmp/_lab.dta", replace
. 
.     local it = 0
.     local changed = 1
.     while `changed' == 1 & `it' < 60 {
  2.         local it = `it' + 1
  3. 
.         use "$tmp/_edges.dta", clear
  4.         rename b ci
  5.         qui merge m:1 ci using "$tmp/_lab.dta", keep(match) nogen
  6.         rename lab lab_b
  7.         collapse (min) lab_b, by(a)
  8.         rename a ci
  9.         qui save "$tmp/_nb.dta", replace
 10. 
.         use "$tmp/_lab.dta", clear
 11.         qui merge 1:1 ci using "$tmp/_nb.dta", keep(master match) nogen
 12.         gen double lab_new = min(lab, lab_b)
 13.         drop lab_b
 14. 
.         * path compression: replace my label by the label of my label
.         preserve
 15.             keep ci lab_new
 16.             rename ci      k_
 17.             rename lab_new lab_of_k
 18.             qui save "$tmp/_ll.dta", replace
 19.         restore
 20.         gen double k_ = lab_new
 21.         qui merge m:1 k_ using "$tmp/_ll.dta", keep(master match) nogen
 22.         qui replace lab_new = min(lab_new, lab_of_k)
 23.         drop k_ lab_of_k
 24. 
.         qui count if lab_new < lab
 25.         local changed = (r(N) > 0)
 26.         di as txt "   pass `it': " as res %10.0fc r(N) as txt " labels sti
> ll falling"
 27.         qui replace lab = lab_new
 28.         drop lab_new
 29.         qui save "$tmp/_lab.dta", replace
 30.     }
