. *****************************************************************************
> ***
. * HELPER PROGRAMS
. *****************************************************************************
> ***
. * Every kinship link is held as a two-column file (ci, alter).  Second-degree
. * relations are then just compositions of first-degree ones.
. 
. capture program drop _rev

. program define _rev
  1.     * reverse a link file: (ci -> alter) becomes (alter -> ci)
.     args A OUT
  2.     use "`A'", clear
  3.     rename ci    _t_
  4.     rename alter ci
  5.     rename _t_   alter
  6.     keep ci alter
  7.     qui save "`OUT'", replace
  8. end

. 
. capture program drop _comp

. program define _comp
  1.     * compose: A is ci -> mid, B is ci -> alter, result is ci -> alter via
>  mid
.     args A B OUT
  2.     use "`B'", clear
  3.     rename ci mid
  4.     keep mid alter
  5.     qui save "$tmp/_cB_.dta", replace
  6.     use "`A'", clear
  7.     rename alter mid
  8.     keep ci mid
  9.     joinby mid using "$tmp/_cB_.dta"
 10.     keep ci alter
 11.     qui drop if ci == alter | mi(alter)
 12.     qui duplicates drop ci alter, force
 13.     qui save "`OUT'", replace
 14. end

. 
. capture program drop _minus

. program define _minus
  1.     * A minus B, matching on the (ci, alter) pair
.     args A B OUT
  2.     use "`A'", clear
  3.     qui merge 1:1 ci alter using "`B'", keep(master) nogen
  4.     qui save "`OUT'", replace
  5. end

. 
. capture program drop _ndist

. program define _ndist
  1.     * number of DISTINCT values of V inside each group G, saved keyed on G
> .
.     * (egen's nvals() lives in egenmore, which is not assumed to be installed
> .)
.     args G V NAME OUT
  2.     preserve
  3.         keep `G' `V'
  4.         qui duplicates drop
  5.         bysort `G': gen long `NAME' = _N
  6.         by `G': keep if _n == 1
  7.         keep `G' `NAME'
  8.         qui save "`OUT'", replace
  9.     restore
 10. end

. 
. capture program drop _tag

. program define _tag
  1.     * stamp a link file with a relation code, degree and route, then appen
> d it
.     * to the accumulating kinship network
.     args A rel grado via
  2.     use "`A'", clear
  3.     qui count
  4.     local nn = r(N)
  5.     gen byte rel   = `rel'
  6.     gen byte grado = `grado'
  7.     gen byte via   = `via'
  8.     qui append using "$tmp/_red.dta"
  9.     qui save "$tmp/_red.dta", replace
 10.     di as txt "   rel `rel' (grado `grado', via `via'): " as res %10.0fc `
> nn' as txt " edges"
 11. end

. 
. 
