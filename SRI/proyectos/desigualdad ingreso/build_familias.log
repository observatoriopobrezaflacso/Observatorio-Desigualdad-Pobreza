. if $HACER_DINASTIA {
. 
.     use "$tmp/_pers.dta", clear
.     keep ci pad mad lnk_conyugue
.     qui expand 3
.     bysort ci: gen byte s = _n
.     gen double b = cond(s == 1, pad, cond(s == 2, mad, lnk_conyugue))
(441,704 missing values generated)
