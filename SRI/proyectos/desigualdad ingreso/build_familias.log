> ) & !mi(anc_up)
 25.         drop anc_up
 26.     }
 27.     qui replace id_fam_extendida`v' = id_union if mi(id_fam_extendida`v')
 28.     label var id_fam_extendida`v' "familia extendida (bloque de `B' gen. d
> e familias nucleares)"
 29. }
