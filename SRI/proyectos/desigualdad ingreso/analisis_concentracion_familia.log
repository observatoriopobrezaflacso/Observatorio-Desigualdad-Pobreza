. *--- 2.2 the family units ---------------------------------------------------
> -
. foreach u in id_fam_nuclear id_fam_nuclear2 id_fam_extendida id_fam_extendida
> 2 id_dinastia {
  2. 
.     if "`u'" == "id_fam_nuclear"    local etq "familia nuclear"
  3.     if "`u'" == "id_fam_nuclear2"   local etq "fam. nuclear (r2)"
  4.     if "`u'" == "id_fam_extendida"  local etq "familia extendida"
  5.     if "`u'" == "id_fam_extendida2" local etq "fam. ext. (2 gen)"
  6.     if "`u'" == "id_dinastia"       local etq "dinastia"
  7. 
.     use "$fake/Bases/bases_temp/_rq.dta", clear
  8.     * A family's wealth is the sum over its members.  For the equal-split
.     * convention the denominator is the number of LIVING ADULTS, so that the
.     * population behind the family rows is the same population as behind the
.     * individual row above and the two are directly comparable.  A family wit
> h
.     * no living adult gets a floor of 1 (its wealth is zero anyway).
.     gen byte adulto_vivo = age2023 >= $EDAD_MIN & vivo_ref
  9.     collapse (sum) riqueza (sum) n_adultos = adulto_vivo (sum) n_vivos = v
> ivo_ref ///
>              (count) n_pers = riqueza, by(`u')
 10.     qui replace n_adultos = 1 if n_adultos == 0
 11.     gen double peso1 = 1
 12. 
.     foreach pw in peso1 n_adultos {
 13.         if "`pw'" == "peso1" local pe "por familia"
 14.         else                 local pe "equal-split"
 15.         capture _conc riqueza, peso(`pw') unidad("`etq'") pondera("`pe'")
 16.         if _rc == 0 _fila "`etq'" "`pe'" "$res"
 17.     }
 18. }

