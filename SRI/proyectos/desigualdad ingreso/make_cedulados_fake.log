. local nextpid   = 0

. local nextunion = 0

. 
. forvalues b = 1/2 {
  2. 
.     if `b' == 1 {
  3.         local nfound 6000
  4.         local lo     1888
  5.         local hi     1920
  6.         local rounds 5
  7.         local fert  "5.0  4.6  4.0  3.2  2.4"
  8.         local crate "0.85 0.82 0.80 0.76 0.62"
  9.         local chldl "0.05 0.06 0.07 0.09 0.14"
 10.     }
 11.     else {
 12.         local nfound 78000
 13.         local lo     1958
 14.         local hi     1995
 15.         local rounds 2
 16.         local fert  "2.4  1.6"
 17.         local crate "0.80 0.50"
 18.         local chldl "0.10 0.20"
 19.     }
 20. 
.     *---------------------------- founders ----------------------------------
> ---
.     clear
 21.     qui set obs `nfound'
 22.     gen long pid = `nextpid' + _n
 23.     local nextpid = `nextpid' + _N
 24.     gen byte blk      = `b'
 25.     gen byte gen_true = 0
 26.     gen int  yob      = `lo' + int(runiform()*(`hi' - `lo' + 1))
 27.     * P14: a thin tail of implausibly old records (the yaml min yob is 180
> 0)
.     if `b' == 1 qui replace yob = 1800 + int(runiform()*88) if runiform() < 0
> .004
 28.     gen byte female = runiform() < 0.502
 29.     gen long pid_padre_true = .
 30.     gen long pid_madre_true = .
 31.     gen long union_nac_true = .
 32.     append using "$tmp/_pop.dta"
 33.     save "$tmp/_pop.dta", replace
 34. 
.     *---------------------------- reproduction rounds -----------------------
> ---
.     local lastround = `rounds' - 1
 35.     forvalues t = 0/`lastround' {
 36. 
.         local j  = `t' + 1
 37.         local fe : word `j' of `fert'
 38.         local cr : word `j' of `crate'
 39.         local cl : word `j' of `chldl'
 40.         local tn = `t' + 1
 41. 
.         di as txt _n "-- block `b': generation `t' -> `tn'   (fertility `fe',
>  couple rate `cr')"
 42. 
.         use "$tmp/_pop.dta", clear
 43.         qui keep if blk == `b' & gen_true == `t'
 44.         qui count
 45.         if r(N) < 50 continue
 46.         keep pid yob female
 47. 
.         * assortative mating: rank men and women on yob plus noise and pair b
> y
.         * rank, so spousal age gaps are small but not zero
.         gen double sk = yob + rnormal(0, 3)
 48.         qui save "$tmp/_gen.dta", replace
 49. 
.         qui keep if female == 0
 50.         sort sk pid
 51.         gen long k = _n
 52.         rename pid pid_h
 53.         rename yob yob_h
 54.         keep pid_h yob_h k
 55.         qui save "$tmp/_m.dta", replace
 56. 
.         use "$tmp/_gen.dta", clear
 57.         qui keep if female == 1
 58.         sort sk pid
 59.         gen long k = _n
 60.         rename pid pid_w
 61.         rename yob yob_w
 62.         keep pid_w yob_w k
 63.         qui merge 1:1 k using "$tmp/_m.dta", keep(match) nogen
 64.         drop k
 65.         qui keep if runiform() < `cr'
 66.         gen byte tipo = 1
 67.         qui save "$tmp/_u1.dta", replace
 68. 
.         * P13 - serial unions: re-pair a random 12% of the generation at rand
> om
.         * (not assortatively).  People already in a primary union who turn up
.         * here end up with children by two different partners, which is exact
> ly
.         * what makes the "primary union" rule in build_familias.do necessary.
.         use "$tmp/_gen.dta", clear
 69.         qui keep if runiform() < 0.12
 70.         gen double rr = runiform()
 71.         qui save "$tmp/_gen2.dta", replace
 72.         qui keep if female == 0
 73.         sort rr pid
 74.         gen long k = _n
 75.         rename pid pid_h
 76.         rename yob yob_h
 77.         keep pid_h yob_h k
 78.         qui save "$tmp/_m2.dta", replace
 79.         use "$tmp/_gen2.dta", clear
 80.         qui keep if female == 1
 81.         sort rr pid
 82.         gen long k = _n
 83.         rename pid pid_w
 84.         rename yob yob_w
 85.         keep pid_w yob_w k
 86.         qui merge 1:1 k using "$tmp/_m2.dta", keep(match) nogen
 87.         drop k
 88.         gen byte tipo = 2
 89. 
.         append using "$tmp/_u1.dta"
 90.         qui drop if pid_h == pid_w
 91.         gen long union_id = `nextunion' + _n
 92.         local nextunion = `nextunion' + _N
 93. 
.         * every union, fertile or not, is a couple on file
.         preserve
 94.             gen byte gen_true = `t'
 95.             gen byte blk      = `b'
 96.             keep union_id pid_h pid_w tipo gen_true blk
 97.             append using "$tmp/_unions.dta"
 98.             qui save "$tmp/_unions.dta", replace
 99.         restore
100. 
.         *------------------------- births -----------------------------------
> ---
.         gen int nk = rpoisson(`fe')
101.         qui replace nk = rpoisson(`fe'*0.45) if tipo == 2
102.         qui replace nk = 0 if runiform() < `cl'
103.         qui keep if nk > 0 & nk < .
104.         qui expand nk
105. 
.         * maternal age 17-45, children of one union spaced at least a year ap
> art
.         gen int agem = 17 + int(rgamma(4, 2.3))
106.         qui replace agem = 45 if agem > 45
107.         bysort union_id (agem): replace agem = agem[_n-1] + 1 if _n > 1 & 
> agem <= agem[_n-1]
108.         gen int yob_c = yob_w + agem
109.         qui replace yob_c = yob_h + 15 if yob_c - yob_h < 15
110.         qui drop if yob_c > 2023
111. 
.         qui count
112.         if r(N) == 0 continue
113. 
.         gen long pid = `nextpid' + _n
114.         local nextpid = `nextpid' + _N
115.         gen byte female   = runiform() < 0.502
116.         gen byte blk      = `b'
117.         gen byte gen_true = `tn'
118.         rename pid_h  pid_padre_true
119.         rename pid_w  pid_madre_true
120.         rename union_id union_nac_true
121.         rename yob_c  yob
122.         keep pid blk gen_true yob female pid_padre_true pid_madre_true uni
> on_nac_true
123.         append using "$tmp/_pop.dta"
124.         qui save "$tmp/_pop.dta", replace
125.         qui count
126.         di as res "   births kept: " %9.0fc r(N)
127.     }
128. }
