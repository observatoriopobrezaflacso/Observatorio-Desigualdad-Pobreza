.     keep pid cod_inec_ci_actual

.     rename pid pid_padre_true

.     rename cod_inec_ci_actual ci_padre_true

.     qui save "$tmp/_map_p.dta", replace

.     rename pid_padre_true pid_madre_true

.     rename ci_padre_true  ci_madre_true

